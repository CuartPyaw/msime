+    }
+    if (delta != nullptr &&
+        !read_pick_transition(db.get(), "main", previous_key, previous_value, key, value, change.after))
+        return 0;
+    if (!execute_sql(db.get(), "COMMIT"))
+        return 0;
+    if (delta != nullptr)
+    {
+        LearningDelta written;
+        written.picks.push_back(std::move(change));
+        merge_delta(*delta, std::move(written));
+    }
+    return count;
