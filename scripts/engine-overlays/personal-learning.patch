+std::vector<quanpin::LatticeTypoEdge> QuanpinDictionary::collect_typo_edges(const quanpin::Segments &segments,
+                                                                            const quanpin::LatticePath &literal_best,
+                                                                            const quanpin::WordLatticeOptions &options)
+{
+    const size_t n = segments.size();
+    // A syllable the best literal path spells as a lone character is where a typo most likely broke a phrase, so
+    // those are tried first; word spans follow the character counts of the path's words.
+    std::vector<bool> weak(n, false);
+    size_t covered = 0;
+    for (const auto &word : literal_best.words)
+    {
+        const size_t width = HelpcodeUtils::count_utf8_chars(word);
+        if (width == 0 || covered + width > n)
+        {
+            covered = n + 1;
+            break;
+        }
+        if (width == 1)
+            weak[covered] = true;
+        covered += width;
+    }
+    if (covered != n)
+        std::fill(weak.begin(), weak.end(), false);
+    std::vector<size_t> positions;
+    positions.reserve(n);
+    for (size_t i = 0; i < n; ++i)
+        if (weak[i])
+            positions.push_back(i);
+    for (size_t i = 0; i < n; ++i)
+        if (!weak[i])
+            positions.push_back(i);
+
+    struct PlannedKey
+    {
+        size_t start = 0;
+        size_t end = 0;
+        std::string key;
+        double penalty = 0;
+    };
+    std::vector<PlannedKey> planned;
+    std::unordered_set<std::string> seen;
+    const auto base_cost = [&](quanpin::SyllableTypoKind kind) {
+        switch (kind)
+        {
+        case quanpin::SyllableTypoKind::Transposition:
+            return options.typo_transposition_cost;
+        case quanpin::SyllableTypoKind::Neighbor:
+            return options.typo_neighbor_cost;
+        case quanpin::SyllableTypoKind::MissingOrExtra:
+            return options.typo_missing_extra_cost;
+        }
+        return options.typo_missing_extra_cost;
+    };
+    for (const size_t position : positions)
+    {
+        if (planned.size() >= kTypoKeyBudget)
+            break;
+        const std::string &typed = segments[position];
+        std::vector<std::pair<quanpin::SyllableTypo, int>> variants;
+        for (const auto &typo : quanpin::syllable_typos(typed))
+        {
+            if ((current_autocorrect_types_ & quanpin::autocorrect_bit(typo.kind)) != 0)
+                variants.emplace_back(typo, typo_profile_->accepted(typed, typo.syllable));
+        }
+        // Kinds are already cheapest first, so a stable sort on the personal count keeps that as the tie-break.
+        std::stable_sort(variants.begin(), variants.end(),
+                         [](const auto &a, const auto &b) { return a.second > b.second; });
+        for (const auto &[typo, accepted] : variants)
+        {
+            const double penalty = quanpin::PersonalTypoProfile::discounted(base_cost(typo.kind), accepted);
+            for (size_t length = kMinTypoSpanSyllables; length <= kMaxTypoSpanSyllables && length <= n; ++length)
+            {
+                const size_t first = position + 1 >= length ? position + 1 - length : 0;
+                for (size_t start = first; start <= position && start + length <= n; ++start)
+                {
+                    quanpin::Segments span(segments.begin() + static_cast<std::ptrdiff_t>(start),
+                                           segments.begin() + static_cast<std::ptrdiff_t>(start + length));
+                    span[position - start] = typo.syllable;
+                    std::string key = quanpin::join_segments(span);
+                    if (!seen.insert(key).second)
+                        continue;
+                    planned.push_back({start, start + length, std::move(key), penalty});
+                    if (planned.size() >= kTypoKeyBudget)
+                        break;
+                }
+                if (planned.size() >= kTypoKeyBudget)
+                    break;
+            }
+            if (planned.size() >= kTypoKeyBudget)
+                break;
+        }
+    }
+
+    std::unordered_map<std::string, std::vector<quanpin::KeyedQueryItem>> rows;
+    std::vector<std::string> misses;
+    for (const auto &entry : planned)
+    {
+        if (auto cached = typo_span_cache_.get(entry.key))
+            rows.emplace(entry.key, std::move(*cached));
+        else
+            misses.push_back(entry.key);
+    }
+    if (!misses.empty())
+    {
+        auto fetched = quanpin::query_exact_keys_per_key(misses, db_, statement_cache_, kTypoRowsPerKey);
+        for (const auto &key : misses)
+        {
+            auto found = fetched.find(key);
+            std::vector<quanpin::KeyedQueryItem> key_rows;
+            if (found != fetched.end())
+                key_rows = std::move(found->second);
+            typo_span_cache_.insert(key, key_rows);
+            rows.emplace(key, std::move(key_rows));
+        }
+    }
+
+    std::vector<quanpin::LatticeTypoEdge> edges;
+    for (const auto &entry : planned)
+    {
+        const auto found = rows.find(entry.key);
+        if (found == rows.end())
+            continue;
+        for (const auto &row : found->second)
+            edges.push_back({entry.start, entry.end, row.key, row.value, row.weight, entry.penalty});
+    }
+    return edges;
+}
