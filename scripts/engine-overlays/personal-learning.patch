+#include "scheme_type.h"
+#include "../user_dictionary/learning_receipt.h"
+
+#include <cstddef>
+#include <deque>
+#include <optional>
+#include <string>
+
+namespace metasequoia
+{
+// One piece of text the host inserted, newest last in RecentCommits.
+struct RecentCommit
+{
+    std::string text;
+
+    // Code points, which is what one idle Backspace is counted as removing.
+    std::size_t chars = 0;
+
+    std::size_t erased = 0;
+
+    // Lowercase raw input the commit consumed, without apostrophes or helpcodes. Empty for text that no retyped input
+    // can answer (punctuation, raw text, characters the host inserted itself).
+    std::string input;
+
+    SchemeType scheme = SchemeType::Quanpin;
+
+    // What the commit taught the dictionaries, when there was anything and all of it could be recorded.
+    std::optional<user_dictionary::LearningReceipt> receipt;
+
+    bool is_erased() const
+    {
+        return chars > 0 && erased == chars;
+    }
+
+    // `typed` is a prefix of this commit's input under the same scheme.
+    bool same_input(const std::string &typed, SchemeType typed_scheme) const
+    {
+        return !typed.empty() && typed_scheme == scheme && input.compare(0, typed.size(), typed) == 0;
+    }
+};
+
+// The last few commits and how much of each the user has deleted with idle Backspace, so a selection that answers the
+// same input again can take back what the deleted commit taught. It only follows keys the host forwards; hosts reset
+// it whenever the text near the caret changes some other way.
+class RecentCommits
+{
+  public:
+    static constexpr std::size_t kCapacity = 4;
+
+    // Empty text is ignored; the oldest record is dropped beyond kCapacity.
+    void remember(RecentCommit commit);
+    // Replaces the newest record, or remembers `commit` when there is none.
+    void replace_last(RecentCommit commit);
+    // Charges one deleted character to the newest record that still has text left. Deleting past every record means
+    // the host's text no longer matches the ledger, so everything is forgotten.
+    void note_backspace();
+    // Removes and returns the newest fully deleted record whose input starts with `typed`. When none does, every fully
+    // deleted record is forgotten: the user typed something else in their place.
+    std::optional<RecentCommit> take_retraction(const std::string &typed, SchemeType scheme);
+    // Forgets every fully deleted record, for commits that are not a pick among alternatives.
+    void forget_erased();
+    // Keeps the records, which still count characters in the host's text, but nothing they taught is taken back.
+    void drop_receipts(const std::string &text);
+    void clear();
+
+    const std::deque<RecentCommit> &records() const
+    {
+        return records_;
+    }
+
+  private:
+    std::deque<RecentCommit> records_;
+};
