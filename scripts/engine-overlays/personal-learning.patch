+void test_lattice()
+{
+    // 想 leads 翔 by log(4.5) = 1.5 nats of static evidence.
+    const auto lookup = lexicon({{"wo", {{"我", 900000}}},
+                                 {"ni", {{"你", 900000}}},
+                                 {"xiang", {{"想", 450000}, {"翔", 100000}}},
+                                 {"qu", {{"去", 400000}, {"区", 100000}}}});
+    const quanpin::Segments wo_xiang{"wo", "xiang"};
+    const quanpin::Segments wo_xiang_qu{"wo", "xiang", "qu"};
+
+    // Without personal data, a null model and an empty one decode to the same bits.
+    {
+        PersonalNgram empty;
+        quanpin::WordLatticeOptions plain;
+        quanpin::WordLatticeOptions with_empty;
+        with_empty.personal = &empty;
+        const auto a = quanpin::decode_word_lattice(wo_xiang_qu, lookup, plain);
+        const auto b = quanpin::decode_word_lattice(wo_xiang_qu, lookup, with_empty);
+        require(a.size() == b.size(), "An empty personal model changed the number of paths.");
+        for (std::size_t i = 0; i < a.size(); ++i)
+            require(a[i].sentence == b[i].sentence && a[i].log_prob == b[i].log_prob,
+                    "An empty personal model changed a path score.");
+        require(a.front().sentence == "我想去", "The static fixture no longer prefers 我想去.");
+    }
+
+    // Accepting 我翔 once as a decoded sentence is not enough to overturn the static preference; one explicit
+    // pick, which counts twice, is.
+    {
+        PersonalNgram accepted;
+        record_run(accepted, {"我", "翔"}, 1);
+        require(best(wo_xiang, lookup, &accepted) == "我想", "One accepted sentence flipped a strong static path.");
+        PersonalNgram picked;
+        record_run(picked, {"我", "翔"}, 2);
+        require(best(wo_xiang, lookup, &picked) == "我翔", "One explicit pick did not flip the static path.");
+    }
+
+    // After 我想 the user picked 区, after 你想 they picked 去. The bigram (想 -> 区/去) is a tie; only the trigram
+    // can tell the two apart, and it has to beat 去's static lead to do it.
+    {
+        PersonalNgram model;
+        for (int i = 0; i < 4; ++i)
+        {
+            record_run(model, {"我", "想", "区"});
+            record_run(model, {"你", "想", "去"});
+        }
+        require(best(wo_xiang_qu, lookup, &model) == "我想区", "The trigram after 我想 did not select 区.");
+        require(best({"ni", "xiang", "qu"}, lookup, &model) == "你想去", "The trigram after 你想 did not keep 去.");
+    }
+
+    // A known sentence is scored with the same personal term as the decode, and lattice rows carry their words.
+    {
+        PersonalNgram model;
+        record_run(model, {"我", "想", "区"}, 2);
+        quanpin::WordLatticeOptions options;
+        options.personal = &model;
+        options.nbest = 16;
+        const auto paths = quanpin::decode_word_lattice(wo_xiang_qu, lookup, options);
+        const auto target = std::find_if(paths.begin(), paths.end(),
+                                         [](const quanpin::LatticePath &path) { return path.sentence == "我翔去"; });
+        require(target != paths.end(), "The fixture path is missing from the n-best list.");
+
+        std::vector<WordItem> candidates;
+        quanpin::WholeSentenceComparison comparison;
+        quanpin::merge_lattice_candidates(candidates, wo_xiang_qu, lookup, "wo'xiang'qu", options, "我翔去",
+                                          &comparison);
+        require(comparison.fallback_score.has_value() && near(*comparison.fallback_score, target->log_prob),
+                "The known-sentence score did not use the decoder's personal term.");
+        quanpin::WordLatticeOptions plain = options;
+        plain.personal = nullptr;
+        quanpin::WholeSentenceComparison unscored;
+        std::vector<WordItem> unused;
+        quanpin::merge_lattice_candidates(unused, wo_xiang_qu, lookup, "wo'xiang'qu", plain, "我翔去", &unscored);
+        require(unscored.fallback_score.has_value() && *unscored.fallback_score != *comparison.fallback_score,
+                "The known-sentence score ignored the personal model.");
+
+        const auto generated = std::find_if(candidates.begin(), candidates.end(), [](const WordItem &item) {
+            return item.source == CandidateSource::Generated;
+        });
+        require(generated != candidates.end() && generated->word == paths.front().sentence &&
+                    generated->sentence_words == paths.front().words,
+                "A lattice row did not carry its word boundaries.");
+    }
+}
