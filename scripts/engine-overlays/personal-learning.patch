+
+std::uint32_t column_count(sqlite3_stmt *statement, int index)
+{
+    const auto value = sqlite3_column_int64(statement, index);
+    if (value <= 0)
+        return 0;
+    return value > std::numeric_limits<std::uint32_t>::max() ? std::numeric_limits<std::uint32_t>::max()
+                                                             : static_cast<std::uint32_t>(value);
+}
+
+std::optional<std::size_t> count_entries(sqlite3 *database)
+{
+    auto statement = metasequoia::sqlite_prepare_statement(
+        database, "SELECT (SELECT count(*) FROM personal_bigram)+(SELECT count(*) FROM personal_trigram)");
+    if (!statement || sqlite3_step(statement.get()) != SQLITE_ROW)
+        return std::nullopt;
+    return static_cast<std::size_t>(sqlite3_column_int64(statement.get(), 0));
+}
+
+const std::string &or_start(const std::string &word)
+{
+    return word.empty() ? quanpin::NgramTable::sentence_start() : word;
