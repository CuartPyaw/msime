+bool record_pinyin_typos(const std::string &user_db_path, const std::vector<PinyinTypoPair> &pairs,
+                         LearningDelta *delta)
+{
+    constexpr std::size_t kMaxSyllableLength = 6;
+    if (pairs.empty())
+        return false;
+    for (const auto &pair : pairs)
+    {
+        if (!is_lowercase_letters(pair.typed, kMaxSyllableLength) ||
+            !is_lowercase_letters(pair.intended, kMaxSyllableLength) || pair.typed == pair.intended)
+            return false;
+    }
+    UserDatabase db(user_db_path);
+    if (!db || !execute_sql(db.get(), "BEGIN IMMEDIATE"))
+        return false;
+    auto upsert = prepare(db.get(), "INSERT INTO pinyin_typo_counts(typed,intended,accepted) VALUES(?1,?2,1)"
+                                    " ON CONFLICT(typed,intended) DO UPDATE SET"
+                                    " accepted=min(accepted+1,?3),updated_at=unixepoch()");
+    bool ok = static_cast<bool>(upsert);
+    for (const auto &pair : pairs)
+    {
+        if (!ok)
+            break;
+        metasequoia::sqlite_reset_and_clear(upsert.get());
+        ok = bind_text(upsert.get(), 1, pair.typed) && bind_text(upsert.get(), 2, pair.intended) &&
+             sqlite3_bind_int(upsert.get(), 3, kMaxTypoStateCount) == SQLITE_OK &&
+             sqlite3_step(upsert.get()) == SQLITE_DONE;
+    }
+    upsert.reset();
+    // A row-value IN list rather than chained ORs: every OR adds a level of expression depth, and SQLite rejects
+    // statements deeper than SQLITE_MAX_EXPR_DEPTH (1000 by default).
+    std::string keep = "(typed,intended) IN (VALUES ";
+    std::vector<std::string> keep_values;
+    for (const auto &pair : pairs)
+    {
+        const auto first = std::to_string(keep_values.size() + 2);
+        const auto second = std::to_string(keep_values.size() + 3);
+        keep += (keep_values.empty() ? "(?" : ",(?") + first + ",?" + second + ")";
+        keep_values.push_back(pair.typed);
+        keep_values.push_back(pair.intended);
+    }
+    keep += ")";
+    if (ok && trim_typo_table(db.get(), "pinyin_typo_counts", "accepted", keep, keep_values) &&
+        execute_sql(db.get(), "COMMIT"))
+    {
+        if (delta != nullptr)
+            delta->typos.insert(delta->typos.end(), pairs.begin(), pairs.end());
+        return true;
+    }
+    (void)execute_sql(db.get(), "ROLLBACK");
+    return false;
+}
