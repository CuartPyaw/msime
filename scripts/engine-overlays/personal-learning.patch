+void test_model_math()
+{
+    PersonalNgram model;
+    require(model.empty() && model.confidence(start()) == 0.0, "An empty model claimed confidence.");
+
+    // START -> 我 -> 想, each counted twice.
+    record_run(model, {"我", "想"}, 2);
+    require(model.total() == 4 && model.entries() == 3, "Counting a run produced the wrong totals.");
+    // c(我) = 2, so mu = 2 / (2 + 8).
+    require(near(model.confidence("我"), 0.2), "Confidence did not follow c(v) / (c(v) + K).");
+    // P2 = 0.8 * 2/2 + 0.2 * 2/4.
+    require(near(model.bigram_probability("我", "想"), 0.9), "The bigram interpolation is wrong.");
+    // Seen (START, 我) context: (2 - 0.75) / 2 + 0.75 * 1 / 2 * P2.
+    require(near(model.probability(start(), "我", "想"), 0.625 + 0.375 * 0.9), "The trigram back-off is wrong.");
+    // An unseen (u, v) context falls back to the bigram estimate unchanged.
+    require(near(model.probability("别", "我", "想"), 0.9), "An unseen trigram context did not back off.");
+    // Unseen continuation of a seen trigram context gets only the back-off mass.
+    require(near(model.probability(start(), "我", "他"), 0.375 * model.bigram_probability("我", "他")),
+            "An unseen continuation got more than the back-off mass.");
+
+    PersonalNgram capped;
+    for (int i = 0; i < 100; ++i)
+        capped.add(transition("", "甲", "乙"));
+    require(near(capped.confidence("甲"), 0.5), "Confidence was not capped at max_confidence.");
+
+    // A chain start carries no trigram, so the entries are the pair alone.
+    PersonalNgram opening;
+    opening.add(transition("", "", "甲", 3));
+    require(opening.entries() == 1, "A chain-start transition recorded a trigram.");
+    require(near(opening.probability("任意", start(), "甲"), opening.bigram_probability(start(), "甲")),
+            "A chain-start context consulted a trigram.");
+}
+
+void test_key_domains_are_separate()
+{
+    // 甲 is only ever a context and 乙 only ever a continuation. One shared table keyed by the word would give 乙
+    // a context total of 1 and 甲 a word count of 1.
+    PersonalNgram model;
+    model.add_pair("甲", "乙", 1);
+    require(model.confidence("乙") == 0.0, "A continuation count was read as a context total.");
+    require(model.bigram_probability("丙", "甲") == 0.0, "A context total was read as a word count.");
+
+    // A pair (甲, 乙) and a trigram context (甲, 乙) hash the same two strings.
+    PersonalNgram pairs;
+    pairs.add_pair(start(), "甲", 1);
+    pairs.add_pair("甲", "乙", 5);
+    require(pairs.context(&start(), "乙").triple_total == 0, "A pair count was read as a trigram context total.");
+    pairs.add_triple("甲", "乙", "丙", 1);
+    pairs.add_pair("乙", "丙", 1);
+    require(near(pairs.bigram_probability("甲", "乙"), 0.8 + 0.2 * 5.0 / 7.0),
+            "A trigram count leaked into the pair table.");
+}
+
+quanpin::WordLatticeLookup lexicon(const std::map<std::string, std::vector<std::pair<std::string, int>>> &words)
+{
+    return [words](const quanpin::Segments &span) {
+        std::vector<quanpin::LatticeLexeme> rows;
+        if (span.size() != 1)
+            return rows;
+        const auto found = words.find(span.front());
+        if (found == words.end())
+            return rows;
+        for (const auto &[value, weight] : found->second)
+            rows.push_back({span.front(), value, weight});
+        return rows;
+    };
+}
+
+std::string best(const quanpin::Segments &syllables, const quanpin::WordLatticeLookup &lookup,
+                 const PersonalNgram *personal)
+{
+    quanpin::WordLatticeOptions options;
+    options.personal = personal;
+    const auto paths = quanpin::decode_word_lattice(syllables, lookup, options);
+    require(!paths.empty(), "The lattice decoded nothing.");
+    return paths.front().sentence;
+}
