+#include "learning_receipt.h"
+#include "personal_ngram_store.h"
+#include "../common/sqlite_database.h"
+#include "../common/sqlite_statement.h"
+
+#include <sqlite3.h>
+
+#include <algorithm>
+#include <utility>
+
+namespace user_dictionary
+{
+namespace
+{
+using Stmt = metasequoia::SqliteStatement;
+
+constexpr const char *kJournalSchema = "candidate_journal";
+
+constexpr const char *kEnglishSchema = "undo_english";
+
+bool bind_text(sqlite3_stmt *statement, int index, const std::string &value)
+{
+    return sqlite3_bind_text(statement, index, value.c_str(), static_cast<int>(value.size()), SQLITE_TRANSIENT) ==
+           SQLITE_OK;
+}
+
+std::string column_text(sqlite3_stmt *statement, int index)
+{
+    const auto *text = sqlite3_column_text(statement, index);
+    return text == nullptr ? std::string{}
+                           : std::string(reinterpret_cast<const char *>(text),
+                                         static_cast<std::size_t>(sqlite3_column_bytes(statement, index)));
+}
+
+bool execute(sqlite3 *database, const char *sql)
+{
+    return database != nullptr && sqlite3_exec(database, sql, nullptr, nullptr, nullptr) == SQLITE_OK;
+}
+
+// English rows are keyed by (word, display); every other dictionary by (key, value).
+std::string dictionary_row_filter(DictionaryKind kind)
+{
+    return kind == DictionaryKind::English ? "word=?1 AND display=?2" : "key=?1 AND value=?2";
+}
+
+std::string dictionary_schema(DictionaryKind kind)
+{
+    return kind == DictionaryKind::English ? kEnglishSchema : "main";
+}
+
+// Steps a statement that yields at most one row; `found` says whether it did.
+bool step_single(sqlite3_stmt *statement, bool &found)
+{
+    const int step = sqlite3_step(statement);
+    found = step == SQLITE_ROW;
+    return step == SQLITE_ROW || step == SQLITE_DONE;
+}
+
+bool matches_after(sqlite3 *database, const DictionaryRowChange &change)
+{
+    std::optional<std::int64_t> weight;
+    std::optional<JournalRowImage> journal;
+    return read_dictionary_weight(database, dictionary_schema(change.kind), change.kind, change.key, change.value,
+                                  weight) &&
+           read_journal_row(database, kJournalSchema, change.kind, change.key, change.value, journal) &&
+           weight == change.weight_after && journal == change.journal_after;
+}
+
+bool matches_after(sqlite3 *database, const SelectionCountChange &change)
+{
+    std::optional<std::int64_t> count;
+    return read_selection_count(database, kJournalSchema, change.context_key, change.entry_key, change.value, count) &&
+           count == change.after;
+}
+
+bool matches_after(sqlite3 *database, const PickTransitionChange &change)
+{
+    std::optional<PickTransitionImage> image;
+    return read_pick_transition(database, kJournalSchema, change.previous_key, change.previous_value, change.key,
+                                change.value, image) &&
+           image == change.after;
+}
+
+// The weights written back are ones these rows already held before the commit, so they are inside the managed range
+// the ranking writer keeps (kManagedWeightCeiling and its floor) by construction and are written verbatim.
+bool restore_row(sqlite3 *database, const DictionaryRowChange &change)
+{
+    const std::string table = dictionary_table_name(change.kind, change.key);
+    if (table.empty())
+        return false;
+    const std::string target = dictionary_schema(change.kind) + ".\"" + table + "\"";
+    const std::string filter = dictionary_row_filter(change.kind);
+    if (!change.weight_before)
+    {
+        auto remove = metasequoia::sqlite_prepare_statement(database, "DELETE FROM " + target + " WHERE " + filter);
+        if (!remove || !bind_text(remove.get(), 1, change.key) || !bind_text(remove.get(), 2, change.value) ||
+            sqlite3_step(remove.get()) != SQLITE_DONE)
+            return false;
+    }
+    else
+    {
+        // The writers never delete a working row, so a row present before is present now and only its weight moved.
+        auto update =
+            metasequoia::sqlite_prepare_statement(database, "UPDATE " + target + " SET weight=?3 WHERE " + filter);
+        if (!update || !bind_text(update.get(), 1, change.key) || !bind_text(update.get(), 2, change.value) ||
+            sqlite3_bind_int64(update.get(), 3, *change.weight_before) != SQLITE_OK ||
+            sqlite3_step(update.get()) != SQLITE_DONE || sqlite3_changes(database) == 0)
+            return false;
+    }
+
+    const std::string journal = std::string(kJournalSchema) + ".user_dictionary_operations";
+    if (!change.journal_before)
+    {
+        // Removing the row, never writing a 'delete' operation: a tombstone would delete a shipped row on replay.
+        auto remove = metasequoia::sqlite_prepare_statement(
+            database, "DELETE FROM " + journal + " WHERE dictionary=?1 AND key=?2 AND value=?3");
+        return remove && bind_text(remove.get(), 1, dictionary_kind_name(change.kind)) &&
+               bind_text(remove.get(), 2, change.key) && bind_text(remove.get(), 3, change.value) &&
+               sqlite3_step(remove.get()) == SQLITE_DONE;
+    }
+    const JournalRowImage &row = *change.journal_before;
+    auto upsert = metasequoia::sqlite_prepare_statement(
+        database, "INSERT INTO " + journal +
+                      "(dictionary,key,value,operation,weight,display,user_inserted,updated_at)"
+                      " VALUES(?1,?2,?3,?4,?5,?6,?7,?8) ON CONFLICT(dictionary,key,value) DO UPDATE SET"
+                      " operation=excluded.operation,weight=excluded.weight,display=excluded.display,"
+                      "user_inserted=excluded.user_inserted,updated_at=excluded.updated_at");
+    return upsert && bind_text(upsert.get(), 1, dictionary_kind_name(change.kind)) &&
+           bind_text(upsert.get(), 2, change.key) && bind_text(upsert.get(), 3, change.value) &&
+           bind_text(upsert.get(), 4, row.operation) && sqlite3_bind_int64(upsert.get(), 5, row.weight) == SQLITE_OK &&
+           bind_text(upsert.get(), 6, row.display) &&
+           sqlite3_bind_int(upsert.get(), 7, row.user_inserted) == SQLITE_OK &&
+           sqlite3_bind_int64(upsert.get(), 8, row.updated_at) == SQLITE_OK &&
+           sqlite3_step(upsert.get()) == SQLITE_DONE;
+}
+
+bool restore_selection(sqlite3 *database, const SelectionCountChange &change)
+{
+    const std::string table = std::string(kJournalSchema) + ".candidate_selection_state";
+    auto statement = metasequoia::sqlite_prepare_statement(
+        database, change.before ? "INSERT INTO " + table +
+                                      "(context_key,entry_key,value,selection_count) VALUES(?1,?2,?3,?4)"
+                                      " ON CONFLICT(context_key,entry_key,value) DO UPDATE SET"
+                                      " selection_count=excluded.selection_count"
+                                : "DELETE FROM " + table + " WHERE context_key=?1 AND entry_key=?2 AND value=?3");
+    return statement && bind_text(statement.get(), 1, change.context_key) &&
+           bind_text(statement.get(), 2, change.entry_key) && bind_text(statement.get(), 3, change.value) &&
+           (!change.before || sqlite3_bind_int64(statement.get(), 4, *change.before) == SQLITE_OK) &&
+           sqlite3_step(statement.get()) == SQLITE_DONE;
+}
+
+bool restore_pick(sqlite3 *database, const PickTransitionChange &change)
+{
+    const std::string table = std::string(kJournalSchema) + ".pick_transitions";
+    auto statement = metasequoia::sqlite_prepare_statement(
+        database,
+        change.before
+            ? "INSERT INTO " + table +
+                  "(previous_key,previous_value,key,value,count,updated_at) VALUES(?1,?2,?3,?4,?5,?6)"
+                  " ON CONFLICT(previous_key,previous_value,key,value) DO UPDATE SET"
+                  " count=excluded.count,updated_at=excluded.updated_at"
+            : "DELETE FROM " + table + " WHERE previous_key=?1 AND previous_value=?2 AND key=?3 AND value=?4");
+    return statement && bind_text(statement.get(), 1, change.previous_key) &&
+           bind_text(statement.get(), 2, change.previous_value) && bind_text(statement.get(), 3, change.key) &&
+           bind_text(statement.get(), 4, change.value) &&
+           (!change.before || (sqlite3_bind_int64(statement.get(), 5, change.before->count) == SQLITE_OK &&
+                               sqlite3_bind_int64(statement.get(), 6, change.before->updated_at) == SQLITE_OK)) &&
+           sqlite3_step(statement.get()) == SQLITE_DONE;
+}
+
+// A pair taken back to zero is deleted rather than kept at zero, so it no longer holds a slot in the bounded table.
+bool retract_typo(sqlite3 *database, const PinyinTypoPair &typo)
+{
+    const std::string table = std::string(kJournalSchema) + ".pinyin_typo_counts";
+    auto statement = metasequoia::sqlite_prepare_statement(
+        database, "UPDATE " + table + " SET accepted=accepted-1 WHERE typed=?1 AND intended=?2 AND accepted > 0");
+    if (!statement || !bind_text(statement.get(), 1, typo.typed) || !bind_text(statement.get(), 2, typo.intended) ||
+        sqlite3_step(statement.get()) != SQLITE_DONE)
+        return false;
+    auto cleanup = metasequoia::sqlite_prepare_statement(
+        database, "DELETE FROM " + table + " WHERE typed=?1 AND intended=?2 AND accepted <= 0");
+    return cleanup && bind_text(cleanup.get(), 1, typo.typed) && bind_text(cleanup.get(), 2, typo.intended) &&
+           sqlite3_step(cleanup.get()) == SQLITE_DONE;
+}
+
+bool attach(sqlite3 *database, const std::string &path, const char *schema)
+{
+    auto statement = metasequoia::sqlite_prepare_statement(database, std::string("ATTACH DATABASE ?1 AS ") + schema);
+    return statement && bind_text(statement.get(), 1, path) && sqlite3_step(statement.get()) == SQLITE_DONE;
+}
+
+template <typename Change, typename Same>
+void merge_changes(std::vector<Change> &into, std::vector<Change> from, Same same)
+{
+    for (auto &change : from)
+    {
+        const auto found =
+            std::find_if(into.begin(), into.end(), [&](const Change &existing) { return same(existing, change); });
+        if (found == into.end())
+            into.push_back(std::move(change));
+        else
+            found->after = std::move(change.after);
+    }
+}
+} // namespace
+
+void merge_delta(LearningDelta &into, LearningDelta from)
+{
+    for (auto &row : from.rows)
+    {
+        const auto found = std::find_if(into.rows.begin(), into.rows.end(), [&](const DictionaryRowChange &existing) {
+            return existing.kind == row.kind && existing.key == row.key && existing.value == row.value;
+        });
+        if (found == into.rows.end())
+        {
+            into.rows.push_back(std::move(row));
+            continue;
+        }
+        found->weight_after = row.weight_after;
+        found->journal_after = std::move(row.journal_after);
+    }
+    merge_changes(into.selections, std::move(from.selections),
+                  [](const SelectionCountChange &a, const SelectionCountChange &b) {
+                      return a.context_key == b.context_key && a.entry_key == b.entry_key && a.value == b.value;
+                  });
+    merge_changes(into.picks, std::move(from.picks), [](const PickTransitionChange &a, const PickTransitionChange &b) {
+        return a.previous_key == b.previous_key && a.previous_value == b.previous_value && a.key == b.key &&
+               a.value == b.value;
+    });
+    into.contexts.insert(into.contexts.end(), std::make_move_iterator(from.contexts.begin()),
+                         std::make_move_iterator(from.contexts.end()));
+    into.typos.insert(into.typos.end(), std::make_move_iterator(from.typos.begin()),
+                      std::make_move_iterator(from.typos.end()));
+    into.complete = into.complete && from.complete;
+}
+
+bool read_dictionary_weight(sqlite3 *database, const std::string &schema, DictionaryKind kind, const std::string &key,
+                            const std::string &value, std::optional<std::int64_t> &weight)
+{
+    weight.reset();
+    const std::string table = dictionary_table_name(kind, key);
+    if (table.empty())
+        return false;
+    auto statement =
+        metasequoia::sqlite_prepare_statement(database, "SELECT weight FROM " + schema + ".\"" + table + "\" WHERE " +
+                                                            dictionary_row_filter(kind) + " LIMIT 1");
+    bool found = false;
+    if (!statement || !bind_text(statement.get(), 1, key) || !bind_text(statement.get(), 2, value) ||
+        !step_single(statement.get(), found))
+        return false;
+    if (found)
+        weight = sqlite3_column_int64(statement.get(), 0);
+    return true;
+}
+
+bool read_journal_row(sqlite3 *database, const std::string &schema, DictionaryKind kind, const std::string &key,
+                      const std::string &value, std::optional<JournalRowImage> &row)
+{
+    row.reset();
+    auto statement = metasequoia::sqlite_prepare_statement(
+        database, "SELECT operation,weight,display,user_inserted,updated_at FROM " + schema +
+                      ".user_dictionary_operations WHERE dictionary=?1 AND key=?2 AND value=?3");
+    bool found = false;
+    if (!statement || !bind_text(statement.get(), 1, dictionary_kind_name(kind)) ||
+        !bind_text(statement.get(), 2, key) || !bind_text(statement.get(), 3, value) ||
+        !step_single(statement.get(), found))
+        return false;
+    if (found)
+        row = JournalRowImage{column_text(statement.get(), 0), sqlite3_column_int64(statement.get(), 1),
+                              column_text(statement.get(), 2), sqlite3_column_int(statement.get(), 3),
+                              sqlite3_column_int64(statement.get(), 4)};
+    return true;
+}
+
+bool read_selection_count(sqlite3 *database, const std::string &schema, const std::string &context_key,
+                          const std::string &entry_key, const std::string &value, std::optional<std::int64_t> &count)
+{
+    count.reset();
+    auto statement = metasequoia::sqlite_prepare_statement(
+        database, "SELECT selection_count FROM " + schema +
+                      ".candidate_selection_state WHERE context_key=?1 AND entry_key=?2 AND value=?3");
+    bool found = false;
+    if (!statement || !bind_text(statement.get(), 1, context_key) || !bind_text(statement.get(), 2, entry_key) ||
+        !bind_text(statement.get(), 3, value) || !step_single(statement.get(), found))
+        return false;
+    if (found)
+        count = sqlite3_column_int64(statement.get(), 0);
+    return true;
+}
+
+bool read_pick_transition(sqlite3 *database, const std::string &schema, const std::string &previous_key,
+                          const std::string &previous_value, const std::string &key, const std::string &value,
+                          std::optional<PickTransitionImage> &image)
+{
+    image.reset();
+    auto statement = metasequoia::sqlite_prepare_statement(
+        database, "SELECT count,updated_at FROM " + schema +
+                      ".pick_transitions WHERE previous_key=?1 AND previous_value=?2 AND key=?3 AND value=?4");
+    bool found = false;
+    if (!statement || !bind_text(statement.get(), 1, previous_key) || !bind_text(statement.get(), 2, previous_value) ||
+        !bind_text(statement.get(), 3, key) || !bind_text(statement.get(), 4, value) ||
+        !step_single(statement.get(), found))
+        return false;
+    if (found)
+        image = PickTransitionImage{sqlite3_column_int64(statement.get(), 0), sqlite3_column_int64(statement.get(), 1)};
+    return true;
+}
+
+UndoOutcome restore_learning_receipt(const LearningReceipt &receipt)
+{
+    const LearningDelta &delta = receipt.delta;
+    if (!delta.complete)
+        return UndoOutcome::Failed;
+    if (delta.empty())
+        return UndoOutcome::Restored;
+    // Initialize the journal before attaching it, as the removal path does.
+    if (!ensure_user_database(receipt.user_db_path))
+        return UndoOutcome::Failed;
+    auto database =
+        metasequoia::sqlite_open_database(receipt.main_db_path, SQLITE_OPEN_READWRITE | SQLITE_OPEN_FULLMUTEX);
+    if (!database)
+        return UndoOutcome::Failed;
+    sqlite3 *db = database.get();
+    sqlite3_busy_timeout(db, 5000);
+    const bool english = std::any_of(delta.rows.begin(), delta.rows.end(), [](const DictionaryRowChange &row) {
+        return row.kind == DictionaryKind::English;
+    });
+    if (!attach(db, receipt.user_db_path, kJournalSchema) ||
+        (english && !attach(db, receipt.english_db_path, kEnglishSchema)) || !execute(db, "BEGIN IMMEDIATE"))
+        return UndoOutcome::Failed;
+    const auto fail = [db] {
+        (void)execute(db, "ROLLBACK");
+        return UndoOutcome::Failed;
+    };
+
+    // All or nothing: one row rewritten since the commit means part of what would be put back is someone else's.
+    const bool current =
+        std::all_of(delta.rows.begin(), delta.rows.end(), [db](const auto &row) { return matches_after(db, row); }) &&
+        std::all_of(delta.selections.begin(), delta.selections.end(),
+                    [db](const auto &selection) { return matches_after(db, selection); }) &&
+        std::all_of(delta.picks.begin(), delta.picks.end(), [db](const auto &pick) { return matches_after(db, pick); });
+    if (current)
+    {
+        for (const auto &row : delta.rows)
+            if (!restore_row(db, row))
+                return fail();
+        for (const auto &selection : delta.selections)
+            if (!restore_selection(db, selection))
+                return fail();
+        for (const auto &pick : delta.picks)
+            if (!restore_pick(db, pick))
+                return fail();
+    }
+    // Counts do not depend on order, so the commit's share is taken back even when a later write superseded the rows.
+    if (!delta.contexts.empty() && !retract_personal_ngram(db, kJournalSchema, delta.contexts))
+        return fail();
+    for (const auto &typo : delta.typos)
+        if (!retract_typo(db, typo))
+            return fail();
+    if (!execute(db, "COMMIT"))
+        return fail();
+    if (!delta.contexts.empty())
+        PersonalNgramStore::invalidate(receipt.user_db_path);
+    return current ? UndoOutcome::Restored : UndoOutcome::Superseded;
+}
+} // namespace user_dictionary
