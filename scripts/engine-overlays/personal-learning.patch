+        const size_t total_input_length = base.effective_raw_input.size();
+        const bool completes = selection_completes_composition(selected.pinyin, selected.word);
+        size_t effective_length = total_input_length;
+        if (base.helpcode_length > 0)
+        {
+            // A completing selection consumes the helpcode too, but the key it is matched by leaves helpcodes out.
+            effective_length = completes ? total_input_length - (std::min)(base.helpcode_length, total_input_length)
+                                         : word_pinyin_length;
+        }
+        else if (!completes)
+        {
+            effective_length = remove_delimiters(selected.pinyin).size();
+            if (effective_length == 0 || effective_length > total_input_length)
+                effective_length = (std::min)(word_pinyin_length, total_input_length);
+        }
+        consumed = base.raw_input.substr(
+            0, shuangpin::raw_length_for_effective_prefix(base.raw_input_with_cases, effective_length));
+    }
+    else
+    {
+        const std::string raw_input_without_helpcodes =
+            quanpin::strip_active_helpcodes(request().raw_input, request().raw_input_with_cases);
+        if (selection_completes_composition(selected.pinyin, selected.word))
+            consumed = raw_input_without_helpcodes;
+        else
+            consumed = raw_input_without_helpcodes.substr(
+                0, shuangpin::raw_length_for_effective_prefix(
+                       quanpin::strip_active_helpcodes_with_cases(request().raw_input, request().raw_input_with_cases),
+                       remove_delimiters(selected.pinyin).size()));
+    }
