+void test_rerank(const std::filesystem::path &root)
+{
+    const auto directory = root / "rerank";
+    prepare_dictionary(directory);
+    const auto journal = journal_in(directory);
+    {
+        auto owned = make_session(directory);
+        auto &session = *owned;
+        commit(session, "ni", "甲");
+        commit(session, "hao", "寅");
+        require(pair_count(journal, "甲", "寅") == 2 && pair_count(journal, start(), "甲") == 2 &&
+                    triple_count(journal, start(), "甲", "寅") == 2,
+                "Committing dictionary words did not record their context.");
+        // The chain start is context-free: 寅 opened a run, but a new run still sees the static order.
+        commit(session, "hao", "寅");
+    }
+    {
+        auto owned = make_session(directory);
+        auto &session = *owned;
+        commit(session, "ni", "甲");
+        commit(session, "hao", "寅");
+    }
+    {
+        auto owned = make_session(directory);
+        auto &session = *owned;
+        type(session, "hao");
+        require(index_of(session, "子") == 0 && index_of(session, "寅") == 2,
+                "Personal context reordered candidates at the chain start.");
+        session.handle_command(metasequoia::Command::Cancel);
+        commit(session, "ni", "甲");
+        type(session, "hao");
+        require(index_of(session, "寅") == 0 && index_of(session, "子") == 1,
+                "Personal context did not reorder candidates after the previous word.");
+        // Forgetting the context drops the order computed for 甲 from the open list.
+        session.reset_commit_context();
+        require(index_of(session, "子") == 0 && index_of(session, "寅") == 2,
+                "A context change left the list ordered for the forgotten word.");
+        session.handle_command(metasequoia::Command::Cancel);
+        session.reset_commit_context();
+        // Picking 甲 out of nihao leaves hao composing; its candidates follow the word just committed.
+        type(session, "nihao");
+        const auto partial = session.select_candidate(std::string("甲"));
+        require(partial.commit == "甲" && session.has_composition(), "The partial selection did not continue.");
+        require(index_of(session, "寅") == 0, "The rest of a composition was not ordered after the committed word.");
+    }
+
+    // Learning reads the order before reordering: picking the original leader is still an index-0 pick.
+    {
+        InputSession session(SchemeType::Quanpin, 0, true, true, true, paths_in(directory));
+        require(session.set_frequency_adjustment({metasequoia::FrequencyAdjustmentMode::Halve, 1, 1}),
+                "The halve configuration was rejected.");
+        commit(session, "ni", "甲");
+        type(session, "hao");
+        require(index_of(session, "寅") == 0, "The halve fixture lost its personal reordering.");
+        const auto result = session.select_candidate(index_of(session, "子"));
+        require(result.commit == "子" && !result.diagnostic, "Committing the original leader failed.");
+        require(query_integer(directory / "msime.db", "SELECT weight FROM tbl_1_h WHERE value='子'") == 100 &&
+                    query_integer(directory / "msime.db", "SELECT weight FROM tbl_1_h WHERE value='丑'") == 90 &&
+                    query_integer(directory / "msime.db", "SELECT weight FROM tbl_1_h WHERE value='寅'") == 80,
+                "Picking the original leader after reordering rewrote dictionary weights.");
+        require(query_integer(journal, "SELECT COUNT(*) FROM user_dictionary_operations") == 0 &&
+                    query_integer(journal, "SELECT COUNT(*) FROM candidate_selection_state") == 0,
+                "Picking the original leader after reordering wrote frequency state.");
+    }
+}
