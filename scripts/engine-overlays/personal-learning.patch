+namespace metasequoia
+{
+void RecentCommits::remember(RecentCommit commit)
+{
+    if (commit.chars == 0)
+        return;
+    records_.push_back(std::move(commit));
+    while (records_.size() > kCapacity)
+        records_.pop_front();
+}
+
+void RecentCommits::replace_last(RecentCommit commit)
+{
+    if (!records_.empty())
+        records_.pop_back();
+    remember(std::move(commit));
+}
+
+void RecentCommits::note_backspace()
+{
+    for (auto record = records_.rbegin(); record != records_.rend(); ++record)
+    {
+        if (record->erased < record->chars)
+        {
+            ++record->erased;
+            return;
+        }
+    }
+    clear();
+}
+
+std::optional<RecentCommit> RecentCommits::take_retraction(const std::string &typed, SchemeType scheme)
+{
+    for (auto record = records_.rbegin(); record != records_.rend(); ++record)
+    {
+        if (!record->is_erased() || !record->same_input(typed, scheme))
+            continue;
+        RecentCommit taken = std::move(*record);
+        records_.erase(std::next(record).base());
+        return taken;
+    }
+    forget_erased();
+    return std::nullopt;
+}
+
+void RecentCommits::forget_erased()
+{
+    records_.erase(
+        std::remove_if(records_.begin(), records_.end(), [](const RecentCommit &record) { return record.is_erased(); }),
+        records_.end());
+}
+
+void RecentCommits::drop_receipts(const std::string &text)
+{
+    for (auto &record : records_)
+        if (record.text == text)
+            record.receipt.reset();
+}
+
+void RecentCommits::clear()
+{
+    records_.clear();
+}
