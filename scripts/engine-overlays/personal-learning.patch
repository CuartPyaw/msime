+bool ensure_personal_ngram_schema(sqlite3 *database)
+{
+    return execute(database, "CREATE TABLE IF NOT EXISTS personal_bigram("
+                             "previous TEXT NOT NULL,word TEXT NOT NULL,count INTEGER NOT NULL CHECK(count>0),"
+                             "PRIMARY KEY(previous,word)) WITHOUT ROWID;"
+                             "CREATE INDEX IF NOT EXISTS personal_bigram_word ON personal_bigram(word);"
+                             "CREATE TABLE IF NOT EXISTS personal_trigram("
+                             "earlier TEXT NOT NULL,previous TEXT NOT NULL,word TEXT NOT NULL,"
+                             "count INTEGER NOT NULL CHECK(count>0),"
+                             "PRIMARY KEY(earlier,previous,word)) WITHOUT ROWID;"
+                             "CREATE INDEX IF NOT EXISTS personal_trigram_word ON personal_trigram(word);");
+}
+
+bool delete_personal_ngram_word(sqlite3 *database, const std::string &schema, const std::string &word)
+{
+    for (const std::string &sql :
+         {"DELETE FROM " + schema + ".personal_bigram WHERE previous=?1 OR word=?1",
+          "DELETE FROM " + schema + ".personal_trigram WHERE earlier=?1 OR previous=?1 OR word=?1"})
+    {
+        auto statement = metasequoia::sqlite_prepare_statement(database, sql);
+        if (!statement || !bind_text(statement.get(), 1, word) || sqlite3_step(statement.get()) != SQLITE_DONE)
+            return false;
+    }
+    return true;
+}
+
+bool retract_personal_ngram(sqlite3 *database, const std::string &schema,
+                            const std::vector<quanpin::PersonalTransition> &transitions)
+{
+    const auto prepare = [database](const std::string &sql) {
+        return metasequoia::sqlite_prepare_statement(database, sql);
+    };
+    // count>0 is a CHECK, so rows that would reach zero are deleted before the rest are decremented.
+    auto drop_pair = prepare("DELETE FROM " + schema + ".personal_bigram WHERE previous=?1 AND word=?2 AND count<=?3");
+    auto lower_pair = prepare("UPDATE " + schema + ".personal_bigram SET count=count-?3 WHERE previous=?1 AND word=?2");
+    auto drop_triple = prepare("DELETE FROM " + schema +
+                               ".personal_trigram WHERE earlier=?1 AND previous=?2 AND word=?3 AND count<=?4");
+    auto lower_triple = prepare("UPDATE " + schema +
+                                ".personal_trigram SET count=count-?4 WHERE earlier=?1 AND previous=?2 AND word=?3");
+    if (!drop_pair || !lower_pair || !drop_triple || !lower_triple)
+        return false;
+    const std::string &start = quanpin::NgramTable::sentence_start();
+    for (const auto &transition : transitions)
+    {
+        if (transition.word.empty() || transition.times == 0)
+            continue;
+        const std::string &previous = or_start(transition.previous);
+        for (sqlite3_stmt *pair : {drop_pair.get(), lower_pair.get()})
+        {
+            metasequoia::sqlite_reset_and_clear(pair);
+            if (!bind_text(pair, 1, previous) || !bind_text(pair, 2, transition.word) ||
+                sqlite3_bind_int64(pair, 3, transition.times) != SQLITE_OK || sqlite3_step(pair) != SQLITE_DONE)
+                return false;
+        }
+        if (previous == start)
+            continue;
+        for (sqlite3_stmt *triple : {drop_triple.get(), lower_triple.get()})
+        {
+            metasequoia::sqlite_reset_and_clear(triple);
+            if (!bind_text(triple, 1, or_start(transition.earlier)) || !bind_text(triple, 2, previous) ||
+                !bind_text(triple, 3, transition.word) ||
+                sqlite3_bind_int64(triple, 4, transition.times) != SQLITE_OK || sqlite3_step(triple) != SQLITE_DONE)
+                return false;
+        }
+    }
+    return true;
+}
+
+PersonalNgramStore &PersonalNgramStore::for_journal(const std::string &journal_path,
+                                                    const quanpin::PersonalNgramOptions &options)
+{
+    auto &shared = registry();
+    const std::lock_guard<std::mutex> lock(shared.mutex);
+    auto found = shared.stores.find(journal_path);
+    if (found == shared.stores.end())
+        found = shared.stores
+                    .emplace(journal_path,
+                             std::unique_ptr<PersonalNgramStore>(new PersonalNgramStore(journal_path, options)))
+                    .first;
+    return *found->second;
+}
+
+void PersonalNgramStore::release_all()
+{
+    store_generation().fetch_add(1, std::memory_order_acq_rel);
+    auto &shared = registry();
+    const std::lock_guard<std::mutex> lock(shared.mutex);
+    for (auto &entry : shared.stores)
+    {
+        const std::lock_guard<std::mutex> writer(entry.second->writer_mutex_);
+        entry.second->connection_.reset();
+    }
+}
+
+void PersonalNgramStore::invalidate(const std::string &journal_path)
+{
+    auto &shared = registry();
+    const std::lock_guard<std::mutex> lock(shared.mutex);
+    const auto found = shared.stores.find(journal_path);
+    if (found != shared.stores.end())
+        found->second->invalidations_.fetch_add(1, std::memory_order_acq_rel);
+}
+
+PersonalNgramStore::PersonalNgramStore(std::string journal_path, const quanpin::PersonalNgramOptions &options)
+    : path_(std::move(journal_path)), model_(options), loaded_generation_(kNeverLoaded)
+{
+}
+
+bool PersonalNgramStore::stale() const
+{
+    return loaded_generation_.load(std::memory_order_acquire) != store_generation().load(std::memory_order_acquire) ||
+           loaded_invalidations_.load(std::memory_order_acquire) != invalidations_.load(std::memory_order_acquire);
+}
+
+void PersonalNgramStore::refresh()
+{
+    if (!stale())
+        return;
+    const std::lock_guard<std::mutex> writer(writer_mutex_);
+    reload_locked();
+}
+
+PersonalNgramStore::Reader PersonalNgramStore::read()
+{
+    refresh();
+    return Reader(std::shared_lock<std::shared_mutex>(model_mutex_), &model_);
+}
+
+bool PersonalNgramStore::load_from(sqlite3 *database, quanpin::PersonalNgram &model) const
+{
+    auto pairs = metasequoia::sqlite_prepare_statement(database, "SELECT previous,word,count FROM personal_bigram");
+    auto triples =
+        metasequoia::sqlite_prepare_statement(database, "SELECT earlier,previous,word,count FROM personal_trigram");
+    // A journal written before these tables existed simply has no personal data yet.
+    if (!pairs || !triples)
+        return true;
+    int step = SQLITE_ROW;
+    while ((step = sqlite3_step(pairs.get())) == SQLITE_ROW)
+        model.add_pair(column_text(pairs.get(), 0), column_text(pairs.get(), 1), column_count(pairs.get(), 2));
+    if (step != SQLITE_DONE)
+        return false;
+    while ((step = sqlite3_step(triples.get())) == SQLITE_ROW)
+        model.add_triple(column_text(triples.get(), 0), column_text(triples.get(), 1), column_text(triples.get(), 2),
+                         column_count(triples.get(), 3));
+    return step == SQLITE_DONE;
+}
+
+void PersonalNgramStore::reload_locked()
+{
+    const std::uint64_t generation = store_generation().load(std::memory_order_acquire);
+    const std::uint64_t invalidations = invalidations_.load(std::memory_order_acquire);
+    if (loaded_generation_.load(std::memory_order_acquire) == generation &&
+        loaded_invalidations_.load(std::memory_order_acquire) == invalidations)
+        return;
+
+    const auto now = std::chrono::steady_clock::now();
+    if (now < retry_after_)
+        return;
+
+    // Built outside the model lock so a keystroke reading the old counts is never blocked by the disk.
+    quanpin::PersonalNgram fresh(model_.options());
+    bool loaded = true;
+    if (connection_)
+    {
+        loaded = load_from(connection_.get(), fresh);
+    }
+    else
+    {
+        std::error_code error;
+        // Reading must not create the journal: a session that never learns anything leaves no file behind.
+        if (std::filesystem::exists(std::filesystem::u8path(path_), error))
+        {
+            auto database = metasequoia::sqlite_open_database(path_, SQLITE_OPEN_READONLY | SQLITE_OPEN_FULLMUTEX);
+            if (database)
+            {
+                sqlite3_busy_timeout(database.get(), 5000);
+                loaded = load_from(database.get(), fresh);
+            }
+        }
+    }
+    if (!loaded)
+    {
+        // A busy, damaged or unreadable journal keeps the previous counts and stays stale, so a later access loads
+        // again. The pause keeps a lasting failure from costing every keystroke a full read.
+        retry_after_ = now + kReloadRetryPause;
+        return;
+    }
+    {
+        const std::unique_lock<std::shared_mutex> lock(model_mutex_);
+        model_.swap(fresh);
+    }
+    version_.fetch_add(1, std::memory_order_acq_rel);
+    loaded_generation_.store(generation, std::memory_order_release);
+    loaded_invalidations_.store(invalidations, std::memory_order_release);
+}
+
+bool PersonalNgramStore::open_connection_locked()
+{
+    if (connection_)
+        return true;
+    // The shared schema pass creates the whole journal, not only these two tables.
+    if (!ensure_user_database(path_))
+        return false;
+    auto database =
+        metasequoia::sqlite_open_database(path_, SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE | SQLITE_OPEN_FULLMUTEX);
+    if (!database)
+        return false;
+    sqlite3_busy_timeout(database.get(), 5000);
+    connection_ = std::move(database);
+    return true;
+}
+
+bool PersonalNgramStore::write_locked(const std::vector<quanpin::PersonalTransition> &transitions)
+{
+    sqlite3 *database = connection_.get();
+    if (!execute(database, "BEGIN IMMEDIATE"))
+        return false;
+    const auto rollback = [database] {
+        execute(database, "ROLLBACK");
+        return false;
+    };
+    auto pair = metasequoia::sqlite_prepare_statement(
+        database, "INSERT INTO personal_bigram(previous,word,count) VALUES(?1,?2,?3)"
+                  " ON CONFLICT(previous,word) DO UPDATE SET count=count+excluded.count");
+    auto triple = metasequoia::sqlite_prepare_statement(
+        database, "INSERT INTO personal_trigram(earlier,previous,word,count) VALUES(?1,?2,?3,?4)"
+                  " ON CONFLICT(earlier,previous,word) DO UPDATE SET count=count+excluded.count");
+    if (!pair || !triple)
+        return rollback();
+    const std::string &start = quanpin::NgramTable::sentence_start();
+    for (const auto &transition : transitions)
+    {
+        if (transition.word.empty() || transition.times == 0)
+            continue;
+        const std::string &previous = or_start(transition.previous);
+        metasequoia::sqlite_reset_and_clear(pair.get());
+        if (!bind_text(pair.get(), 1, previous) || !bind_text(pair.get(), 2, transition.word) ||
+            sqlite3_bind_int64(pair.get(), 3, transition.times) != SQLITE_OK || sqlite3_step(pair.get()) != SQLITE_DONE)
+            return rollback();
+        if (previous == start)
+            continue;
+        metasequoia::sqlite_reset_and_clear(triple.get());
+        if (!bind_text(triple.get(), 1, or_start(transition.earlier)) || !bind_text(triple.get(), 2, previous) ||
+            !bind_text(triple.get(), 3, transition.word) ||
+            sqlite3_bind_int64(triple.get(), 4, transition.times) != SQLITE_OK ||
+            sqlite3_step(triple.get()) != SQLITE_DONE)
+            return rollback();
+    }
+    pair.reset();
+    triple.reset();
+    if (!execute(database, "COMMIT"))
+        return rollback();
+    return true;
+}
+
+void PersonalNgramStore::decay_locked()
+{
+    sqlite3 *database = connection_.get();
+    if (!execute(database, "BEGIN IMMEDIATE"))
+        return;
+    // Halves until the entries fall to three quarters of the limit, so the next commits do not decay again at once.
+    // Most counts start at 2 (one explicit pick), and a single halving would remove none of them.
+    const std::size_t limit = model_.options().max_transitions;
+    const std::size_t low_water = limit - limit / 4;
+    bool halved = false;
+    for (;;)
+    {
+        // Halving with integer division; rows that would reach 0 are dropped first because count>0 is a CHECK.
+        halved = execute(database, "DELETE FROM personal_bigram WHERE count<2;"
+                                   "UPDATE personal_bigram SET count=count/2;"
+                                   "DELETE FROM personal_trigram WHERE count<2;"
+                                   "UPDATE personal_trigram SET count=count/2;");
+        if (!halved)
+            break;
+        const auto remaining = count_entries(database);
+        if (!remaining)
+        {
+            halved = false;
+            break;
+        }
+        if (*remaining <= low_water)
+            break;
+    }
+    if (!halved || !execute(database, "COMMIT"))
+    {
+        // Disk and memory still agree on the undecayed counts; the next record tries again.
+        execute(database, "ROLLBACK");
+        return;
+    }
+    quanpin::PersonalNgram fresh(model_.options());
+    if (!load_from(database, fresh))
+    {
+        // The halving is committed but could not be read back; reload on next access instead of guessing.
+        invalidations_.fetch_add(1, std::memory_order_acq_rel);
+        return;
+    }
+    {
+        const std::unique_lock<std::shared_mutex> lock(model_mutex_);
+        model_.swap(fresh);
+    }
+    version_.fetch_add(1, std::memory_order_acq_rel);
+}
+
+bool PersonalNgramStore::record(const std::vector<quanpin::PersonalTransition> &transitions)
+{
+    if (transitions.empty())
+        return true;
+    const std::lock_guard<std::mutex> writer(writer_mutex_);
+    reload_locked();
+    if (!open_connection_locked() || !write_locked(transitions))
+        return false;
+    bool over_limit = false;
+    {
+        const std::unique_lock<std::shared_mutex> lock(model_mutex_);
+        for (const auto &transition : transitions)
+            model_.add(transition);
+        over_limit = model_.entries() > model_.options().max_transitions;
+    }
+    version_.fetch_add(1, std::memory_order_acq_rel);
+    if (over_limit)
+        decay_locked();
+    return true;
+}
