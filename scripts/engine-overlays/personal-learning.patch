+        test_shuangpin_key(root);
+        test_replay_and_state(root);
+        test_public_session(root);
+    }
+    catch (const std::exception &error)
+    {
+        std::fprintf(stderr, "%s\n", error.what());
+        return 1;
+    }
+    return 0;
+}
