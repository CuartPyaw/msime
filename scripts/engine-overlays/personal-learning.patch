+void test_consumed_raw()
+{
+    using metasequoia::InputSession;
+    const auto root = std::filesystem::temp_directory_path() /
+                      ("msime-undo-raw-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+    metasequoia::test::ScopedDataDirectoryCleanup cleanup(root);
+    prepare_resources(root);
+    const metasequoia::RuntimePaths paths{root, root, root, root};
+    struct Case
+    {
+        SchemeType scheme;
+
+        const char *input;
+
+        const char *word;
+
+        const char *key;
+    };
+    const std::vector<Case> cases{
+        {SchemeType::Quanpin, "wodeshu", "我的", "wode"},  {SchemeType::Quanpin, "wo'deshu", "我的", "wode"},
+        {SchemeType::Quanpin, "wodeshu", "沃", "wo"},      {SchemeType::Quanpin, "wd", "我的", "wd"},
+        {SchemeType::Quanpin, "wodes", "我的", "wode"},    {SchemeType::Shuangpin, "wodeuu", "我的", "wode"},
+        {SchemeType::Shuangpin, "wodeuu", "沃德", "wode"},
+    };
+    for (const auto &item : cases)
+    {
+        InputSession session(item.scheme, 0, true, true, false, paths);
+        for (const char *key = item.input; *key != '\0'; ++key)
+            session.handle_character(*key);
+        const auto &candidates = session.candidates();
+        const auto found = std::find_if(candidates.begin(), candidates.end(),
+                                        [&](const WordItem &candidate) { return candidate.word == item.word; });
+        require(found != candidates.end(), std::string("Missing consumed-raw candidate for ") + item.input);
+        const std::string key = session.selection_consumed_raw(*found);
+        const std::string before = without_apostrophes(session.get_pinyin_sequence());
+        session.select_candidate(static_cast<std::size_t>(found - candidates.begin()));
+        const std::string after = session.has_composition()
+                                      ? without_apostrophes(session.get_pinyin_sequence())
+                                      : std::string{};
+        require(before.size() >= after.size() && before.compare(before.size() - after.size(), after.size(), after) == 0,
+                std::string("The remaining input is not a suffix for ") + item.input);
+        require(key == before.substr(0, before.size() - after.size()) && key == item.key,
+                std::string("The consumed key differs from the drained input for ") + item.input + ": " + key);
+    }
+}
