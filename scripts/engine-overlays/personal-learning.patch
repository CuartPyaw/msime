+++ b/core/commit_chain.h
@@ -0,0 +1,55 @@
+#pragma once
+
+#include <chrono>
+#include <optional>
+#include <string>
+#include <utility>
+
+namespace metasequoia
+{
+// The last two words committed in one uninterrupted run of pinyin input, which is the context the personal
+// word-sequence model learns and ranks against. Anything that means the next word does not follow the last one
+// (punctuation, raw text, another scheme, a host-reported context change, a long pause) resets it.
+struct CommitChain
+{
+    std::optional<std::string> previous;
+
+    std::optional<std::string> earlier;
+
+    // The last word was committed out of a composition that still has input left, so the next selection
+    // continues the same typed phrase.
+    bool same_composition = false;
+
+    std::chrono::steady_clock::time_point committed_at{};
+
+    // A dictionary row the user picked explicitly, with the canonical quanpin reading it was selected under.
+    struct Pick
+    {
+        std::string canonical_pinyin;
+
+        std::string word;
+
+        std::chrono::steady_clock::time_point committed_at{};
+    };
+
+    // Set only while the last commit was an explicit pick, so the first pick of the next composition can be counted
+    // as its continuation. Any other commit clears it.
+    std::optional<Pick> last_pick;
+
+    void advance(const std::string &word, bool composition_left, std::chrono::steady_clock::time_point now)
+    {
+        earlier = std::move(previous);
+        previous = word;
+        same_composition = composition_left;
+        committed_at = now;
+    }
+
+    void reset()
+    {
+        previous.reset();
+        earlier.reset();
+        same_composition = false;
+        last_pick.reset();
+    }
+};
+} // namespace metasequoia
