+    // With a composition open the host's handling of a key the engine refused is unknown, and so is the text after it.
+    if (has_composition() || code < 0x20 || code > 0x7e)
+    {
+        recent_commits_.clear();
+        return;
+    }
+    recent_commits_.forget_erased();
+    remember_plain_commit(std::string(1, character));
