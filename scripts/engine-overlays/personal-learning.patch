+// inputs the user committed raw instead of taking a correction. Shared by every session on the same journal.
+//
+// Reads come from an immutable snapshot, so a lookup on the keystroke path is one lock and one map lookup. Another
+// process's writes are picked up by refresh_if_changed(), which only compares file stamps unless one moved.
+class PersonalTypoProfile
+{
+  public:
+    static std::shared_ptr<PersonalTypoProfile> shared(const std::filesystem::path &user_db);
