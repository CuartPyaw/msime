+void test_noisy_channel(const std::filesystem::path &root)
+{
+    const auto fixture = make_fixture(root, "noisy", true);
+    auto session = make_session(fixture, kAllTypes);
+    type(*session, "meiganxi");
+    require(session->candidates().front().word == "没干系", "The literal phrase lost the leading seat.");
+    const int row = typo_row(*session);
+    require(row != 0, "A typo sentence led over a strong literal phrase.");
+    cancel(*session);
+}
