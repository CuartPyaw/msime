+
+void InputSession::note_idle_command(Command command)
+{
+    if (!learning_undo_enabled_)
+        return;
+    switch (command)
+    {
+    case Command::Backspace:
+        recent_commits_.note_backspace();
+        return;
+    case Command::CommitCandidate:
+        // The host inserts the space itself.
+        recent_commits_.forget_erased();
+        remember_plain_commit(" ");
+        return;
+    default:
+        // Enter, Escape, caret moves and forward deletion leave text the ledger cannot follow.
+        recent_commits_.clear();
+        return;
+    }
+}
+
+std::optional<user_dictionary::LearningReceipt> InputSession::receipt_for(user_dictionary::LearningDelta delta) const
+{
+    if (!delta.complete || delta.empty())
+        return std::nullopt;
+    return user_dictionary::LearningReceipt{path_to_utf8(paths_.dictionary(assets::main_dictionary)),
+                                            path_to_utf8(paths_.dictionary(assets::english_dictionary)),
+                                            path_to_utf8(paths_.user(assets::user_journal)), std::move(delta)};
+}
+
+std::optional<std::string> InputSession::retract_erased_commit(const WordItem &selected,
+                                                               const std::string &consumed_raw,
+                                                               std::optional<std::size_t> &learn_index,
+                                                               bool &learn_selected_copy)
+{
+    auto erased = recent_commits_.take_retraction(consumed_raw, scheme());
+    // Picking the deleted word again confirms it; there is nothing to take back.
+    if (!erased || erased->text == selected.word || !erased->receipt)
+        return std::nullopt;
+    switch (user_dictionary::restore_learning_receipt(*erased->receipt))
+    {
+    case user_dictionary::UndoOutcome::Superseded:
+        return std::nullopt;
+    case user_dictionary::UndoOutcome::Failed:
+        return std::string("Unable to undo the previous selection's learning.");
+    case user_dictionary::UndoOutcome::Restored:
+        break;
+    }
+    // The ranking writer computes its new weights from the candidates' in-memory weights, so the list must be queried
+    // again after the restore rather than re-wrapped.
+    auto diagnostic = refresh_after_candidate_change();
+    learn_index.reset();
+    if (is_sentence_learning_source(selected.source))
+    {
+        learn_selected_copy = true;
+        return diagnostic;
+    }
+    const auto &refreshed = candidates();
+    const auto found = std::find_if(refreshed.begin(), refreshed.end(), [&](const WordItem &item) {
+        return item.word == selected.word && item.canonical_pinyin == selected.canonical_pinyin &&
+               item.source == selected.source;
+    });
+    // A selection the refreshed list no longer has is committed without learning rather than learned under a guess.
+    if (found != refreshed.end())
+        learn_index = ranking_index(static_cast<std::size_t>(found - refreshed.begin()));
+    return diagnostic;
+}
