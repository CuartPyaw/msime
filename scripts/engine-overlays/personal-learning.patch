+void test_chain_breaks(const std::filesystem::path &root)
+{
+    struct Case
+    {
+        const char *name;
+
+        std::function<void(InputSession &)> action;
+
+        bool breaks;
+    };
+    const auto base = std::chrono::steady_clock::now();
+    const std::vector<Case> cases{
+        {"nothing", [](InputSession &) {}, false},
+        {"cancel",
+         [](InputSession &session) {
+             type(session, "hao");
+             session.handle_command(metasequoia::Command::Cancel);
+         },
+         false},
+        {"punctuation", [](InputSession &session) { session.handle_punctuation(','); }, true},
+        {"idle backspace", [](InputSession &session) { session.handle_command(metasequoia::Command::Backspace); },
+         true},
+        {"idle digit", [](InputSession &session) { session.handle_character('1'); }, true},
+        {"reset context", [](InputSession &session) { session.reset_commit_context(); }, true},
+        {"raw commit",
+         [](InputSession &session) {
+             type(session, "hao");
+             session.handle_command(metasequoia::Command::CommitRaw);
+         },
+         true},
+        {"flushed pick",
+         [](InputSession &session) {
+             type(session, "hao");
+             session.finish_composition();
+         },
+         true},
+        {"short gap",
+         [base](InputSession &session) {
+             session.set_steady_clock_provider([base] { return base + std::chrono::seconds(5); });
+         },
+         false},
+        {"long gap",
+         [base](InputSession &session) {
+             session.set_steady_clock_provider([base] { return base + std::chrono::seconds(30); });
+         },
+         true},
+    };
+    std::size_t index = 0;
+    for (const auto &entry : cases)
+    {
+        const auto directory = root / ("break-" + std::to_string(index++));
+        prepare_dictionary(directory);
+        auto owned = make_session(directory);
+        auto &session = *owned;
+        session.set_steady_clock_provider([base] { return base; });
+        commit(session, "shan", "山");
+        entry.action(session);
+        commit(session, "shui", "水");
+        const bool counted = transition_count(directory, "山", "水") == 1;
+        if (entry.breaks == counted)
+        {
+            std::fprintf(stderr, "pick pair case: %s\n", entry.name);
+            throw std::runtime_error("A pick pair break point did not behave as specified.");
+        }
+    }
+
+    // A pause before typing shorter than the idle limit still ends the pair when the pick itself comes too late.
+    const auto directory = root / "late-pick";
+    prepare_dictionary(directory);
+    auto owned = make_session(directory);
+    auto &session = *owned;
+    session.set_steady_clock_provider([base] { return base; });
+    commit(session, "shan", "山");
+    session.set_steady_clock_provider([base] { return base + std::chrono::seconds(5); });
+    type(session, "shui");
+    session.set_steady_clock_provider([base] { return base + std::chrono::seconds(11); });
+    require(session.select_candidate(std::string("水")).commit == std::string("水"), "The late pick failed.");
+    require(transition_rows(directory) == 0, "A pick more than the pair gap after the previous one was counted.");
+}
+
+void test_ineligible_commits(const std::filesystem::path &root)
+{
+    const auto directory = root / "ineligible";
+    prepare_dictionary(directory);
+    auto owned = make_session(directory);
+    auto &session = *owned;
+
+    // A decoded sentence is not an explicit pick, on either side of the pair.
+    commit(session, "shan", "山");
+    type(session, "haohaohao");
+    const auto &candidates = session.candidates();
+    const auto sentence = std::find_if(candidates.begin(), candidates.end(),
+                                       [](const WordItem &item) { return item.source == CandidateSource::Generated; });
+    require(sentence != candidates.end(), "The lattice offered no sentence for the fixture.");
+    session.select_candidate(static_cast<std::size_t>(sentence - candidates.begin()));
+    commit(session, "shui", "水");
+    require(transition_rows(directory) == 0, "A sentence commit was counted as a pick.");
+
+    // Five characters exceed the word cap; a symbol is not a Han word.
+    session.reset_commit_context();
+    commit(session, "haohao", "好好");
+    commit(session, "nihaoma", "你好吗");
+    session.reset_commit_context();
+    commit(session, "shan", "山");
+    commit(session, "xing", "✓");
+    require(transition_rows(directory) == 0, "An over-long or non-Han pair was counted.");
+
+    // Picks inside one composition are already stored as a phrase and are not counted again.
+    session.reset_commit_context();
+    type(session, "shanshui");
+    require(session.select_candidate(std::string("山")).commit == std::string("山") && session.has_composition(),
+            "The partial pick did not continue the composition.");
+    require(session.select_candidate(std::string("水")).commit == std::string("水"), "The second pick failed.");
+    require(has_shanshui(directory) && transition_rows(directory) == 0,
+            "Picks within one composition were counted across compositions.");
+}
+
+void test_deleted_word_stays_deleted(const std::filesystem::path &root)
+{
+    const auto directory = root / "deleted";
+    prepare_dictionary(directory);
+    auto owned = make_session(directory);
+    auto &session = *owned;
+    for (int i = 0; i < 3; ++i)
+    {
+        cycle(session);
+        session.reset_commit_context();
+    }
+    require(has_shanshui(directory), "The fixture word was not created.");
+    type(session, "shanshui");
+    require(session.remove_candidate(index_of(session, "山水")).handled, "Removing the created word failed.");
+    session.handle_command(metasequoia::Command::Cancel);
+    require(!has_shanshui(directory), "The created word was not removed.");
+    for (int i = 0; i < 4; ++i)
+    {
+        cycle(session);
+        session.reset_commit_context();
+    }
+    require(!has_shanshui(directory), "A deleted word was recreated from the same picks.");
+}
