+constexpr std::size_t kMaxGroup = 16;
+} // namespace
+
+std::optional<std::vector<WordItem>> personal_context_order(const std::vector<WordItem> &candidates,
+                                                            const quanpin::PersonalNgram &model,
+                                                            const std::string *earlier, const std::string &previous)
+{
+    if (candidates.size() < 2 || !is_dictionary_candidate_source(candidates.front().source))
+        return std::nullopt;
+    const auto context = model.context(earlier, previous);
+    const double mu = context.confidence;
+    if (mu <= 0.0)
+        return std::nullopt;
+
+    const std::size_t characters = HelpcodeUtils::count_utf8_chars(candidates.front().word);
+    std::size_t group = 0;
+    while (group < candidates.size() && group < kMaxGroup && is_dictionary_candidate_source(candidates[group].source) &&
+           HelpcodeUtils::count_utf8_chars(candidates[group].word) == characters)
+        ++group;
+    if (group < 2)
+        return std::nullopt;
+
+    std::vector<double> personal(group, 0.0);
+    double personal_sum = 0.0;
+    double weight_sum = 0.0;
+    for (std::size_t i = 0; i < group; ++i)
+    {
+        personal[i] = model.probability(context, candidates[i].word);
+        personal_sum += personal[i];
+        weight_sum += static_cast<double>((std::max)(candidates[i].weight, std::int64_t{1}));
+    }
+    if (personal_sum <= 0.0)
+        return std::nullopt;
+
+    std::vector<std::pair<double, std::size_t>> scored;
+    scored.reserve(group);
+    for (std::size_t i = 0; i < group; ++i)
+    {
+        const double share = static_cast<double>((std::max)(candidates[i].weight, std::int64_t{1})) / weight_sum;
+        scored.emplace_back(std::log((1.0 - mu) * share + mu * personal[i] / personal_sum), i);
+    }
+    std::stable_sort(scored.begin(), scored.end(),
+                     [](const auto &lhs, const auto &rhs) { return lhs.first > rhs.first; });
+    bool changed = false;
+    for (std::size_t i = 0; i < group; ++i)
+        changed = changed || scored[i].second != i;
+    if (!changed)
+        return std::nullopt;
+
+    std::vector<WordItem> ordered;
+    ordered.reserve(candidates.size());
+    for (const auto &entry : scored)
+        ordered.push_back(candidates[entry.second]);
+    ordered.insert(ordered.end(), candidates.begin() + static_cast<std::ptrdiff_t>(group), candidates.end());
+    return ordered;
+}
