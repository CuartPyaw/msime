+    if (delta != nullptr &&
+        !read_pick_transition(db.get(), "main", previous_key, previous_value, key, value, change.before))
+        return 0;
+    auto upsert = prepare(db.get(), "INSERT INTO pick_transitions(previous_key,previous_value,key,value,count)"
+                                    " VALUES(?1,?2,?3,?4,1)"
+                                    " ON CONFLICT(previous_key,previous_value,key,value) DO UPDATE SET"
+                                    " count=count+1,updated_at=unixepoch() RETURNING count");
+    if (!upsert || !bind_text(upsert.get(), 1, previous_key) || !bind_text(upsert.get(), 2, previous_value) ||
