+void test_store(const std::filesystem::path &root)
+{
+    const auto directory = root / "store";
+    std::filesystem::create_directories(directory);
+    const auto journal = journal_in(directory);
+    auto &store = PersonalNgramStore::for_journal(metasequoia::path_to_utf8(journal));
+    require(store.read().model_if_any() == nullptr, "A missing journal produced personal data.");
+    require(!std::filesystem::exists(journal), "Reading personal data created the journal.");
+
+    require(store.record({transition("", "", "我", 2), transition("", "我", "想", 2)}),
+            "Recording personal transitions failed.");
+    const double before = store.read().model().probability(start(), "我", "想");
+    require(before > 0.0 && pair_count(journal, "我", "想") == 2 && triple_count(journal, start(), "我", "想") == 2,
+            "Recorded transitions did not reach the journal.");
+
+    // Reopened from disk the counts are the same.
+    user_dictionary::close_default_user_database();
+    require(near(store.read().model().probability(start(), "我", "想"), before),
+            "Reloading from the journal changed the counts.");
+
+    // A failed transaction leaves memory untouched.
+    execute(journal, "CREATE TRIGGER reject_personal BEFORE INSERT ON personal_bigram "
+                     "BEGIN SELECT RAISE(FAIL, 'injected'); END;");
+    const auto version = store.version();
+    require(!store.record({transition("我", "想", "去", 2)}), "A rejected write reported success.");
+    require(store.version() == version && store.read().model().bigram_probability("想", "去") == 0.0,
+            "A rolled-back write changed the in-memory model.");
+    execute(journal, "DROP TRIGGER reject_personal;");
+
+    // Decay halves every count once the entry limit is passed, and memory matches the disk afterwards.
+    const auto decay_journal = metasequoia::path_to_utf8(root / "decay" / "msime_user.db");
+    std::filesystem::create_directories(root / "decay");
+    quanpin::PersonalNgramOptions tight;
+    tight.max_transitions = 3;
+    auto &decaying = PersonalNgramStore::for_journal(decay_journal, tight);
+    require(decaying.record({transition("", "", "甲", 4), transition("", "甲", "乙", 3)}), "Decay fixture failed.");
+    require(decaying.read().model().entries() == 3, "The decay fixture should sit at the limit.");
+    require(decaying.record({transition("甲", "乙", "丙", 1)}), "The write that crosses the limit failed.");
+    const auto decay_path = std::filesystem::u8path(decay_journal);
+    require(pair_count(decay_path, start(), "甲") == 2 && pair_count(decay_path, "甲", "乙") == 1 &&
+                pair_count(decay_path, "乙", "丙") == 0 && triple_count(decay_path, start(), "甲", "乙") == 1 &&
+                triple_count(decay_path, "甲", "乙", "丙") == 0,
+            "Decay did not halve the journal counts.");
+    const auto decayed = decaying.read().model().probability(start(), "甲", "乙");
+    const auto decayed_entries = decaying.read().model().entries();
+    user_dictionary::close_default_user_database();
+    require(decaying.read().model().entries() == decayed_entries &&
+                near(decaying.read().model().probability(start(), "甲", "乙"), decayed),
+            "Decay left memory and the journal disagreeing.");
+
+    // Explicit picks all count 2, so one halving would remove nothing; decay keeps going until the model is back
+    // under three quarters of the limit.
+    const auto picks_journal = metasequoia::path_to_utf8(root / "decay-picks" / "msime_user.db");
+    std::filesystem::create_directories(root / "decay-picks");
+    quanpin::PersonalNgramOptions four;
+    four.max_transitions = 4;
+    auto &picks = PersonalNgramStore::for_journal(picks_journal, four);
+    require(picks.record({transition("", "", "甲", 2), transition("", "甲", "乙", 2)}), "Pick fixture failed.");
+    require(picks.record({transition("甲", "乙", "丙", 2)}), "The pick that crosses the limit failed.");
+    const auto picks_path = std::filesystem::u8path(picks_journal);
+    require(picks.read().model().entries() <= 3 && personal_rows(picks_path) <= 3,
+            "Decay left the model above the limit.");
+    user_dictionary::close_default_user_database();
+    require(picks.read().model().entries() == static_cast<std::size_t>(personal_rows(picks_path)),
+            "Repeated decay left memory and the journal disagreeing.");
+}
