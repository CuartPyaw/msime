+void test_mask_cache(const std::filesystem::path &root)
+{
+    const auto fixture = make_fixture(root, "mask-cache");
+    const auto fresh = [&](unsigned mask) {
+        auto session = make_session(fixture, mask);
+        type(*session, "sahng");
+        return words_of(*session);
+    };
+    const auto masked = fresh(kTableTypes);
+    const auto unmasked = fresh(0);
+    require(masked != unmasked, "The fixture does not tell the two masks apart.");
+
+    auto session = make_session(fixture, kTableTypes);
+    for (const unsigned mask : {kTableTypes, 0u, kTableTypes})
+    {
+        session->set_quanpin_autocorrect_types(mask);
+        type(*session, "sahng");
+        require(words_of(*session) == (mask == 0 ? unmasked : masked),
+                "A list cached under one mask was served under another.");
+        cancel(*session);
+    }
+}
