+// Typo learning describes habits, not dictionary content, so a small bounded table is enough; the rows that matter are
+// the ones seen often.
+constexpr int kMaxTypoStateRows = 2048;
+
+constexpr int kMaxTypoStateCount = 1000;
+
+constexpr std::size_t kMaxSuppressedInputLength = 64;
+
+bool is_lowercase_letters(const std::string &text, std::size_t max_length)
+{
+    return !text.empty() && text.size() <= max_length &&
+           std::all_of(text.begin(), text.end(), [](char ch) { return ch >= 'a' && ch <= 'z'; });
+}
+
+bool table_exists(sqlite3 *db, const char *table)
+{
+    auto stmt = prepare(db, "SELECT 1 FROM sqlite_master WHERE type='table' AND name=?1");
+    return stmt && bind_text(stmt.get(), 1, table) && sqlite3_step(stmt.get()) == SQLITE_ROW;
+}
+
+// Deletes the least used rows, oldest first, until at most kMaxTypoStateRows remain. The rows matching `keep` (with
+// `keep_values` bound from ?2) are the ones this transaction just wrote: a new row starts at the lowest count, so
+// without the exclusion a full table would delete it in the same commit that created it.
+bool trim_typo_table(sqlite3 *db, const std::string &table, const std::string &count_column, const std::string &keep,
+                     const std::vector<std::string> &keep_values)
+{
+    const std::string sql = "DELETE FROM " + table + " WHERE rowid IN (SELECT rowid FROM " + table + " WHERE NOT (" +
+                            keep + ") ORDER BY " + count_column +
+                            " ASC, updated_at ASC, rowid ASC LIMIT max(0, (SELECT count(*) FROM " + table + ") - ?1))";
+    auto stmt = prepare(db, sql);
+    if (!stmt || sqlite3_bind_int(stmt.get(), 1, kMaxTypoStateRows) != SQLITE_OK)
+        return false;
+    for (std::size_t i = 0; i < keep_values.size(); ++i)
+    {
+        if (!bind_text(stmt.get(), static_cast<int>(i) + 2, keep_values[i]))
+            return false;
+    }
+    return sqlite3_step(stmt.get()) == SQLITE_DONE;
+}
