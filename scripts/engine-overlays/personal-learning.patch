+void test_suppression(const std::filesystem::path &root)
+{
+    const auto fixture = make_fixture(root, "suppression");
+    {
+        auto session = make_session(fixture, kTableTypes);
+        type(*session, "shabg");
+        require(!session->candidates().empty() && session->candidates().front().word == "上" &&
+                    session->candidates().front().corrected_from == "shabg",
+                "The neighbor correction was not offered.");
+        const auto raw = session->handle_command(metasequoia::Command::CommitRaw);
+        require(raw.handled && raw.commit == "shabg" && !raw.diagnostic, "The raw letters were not committed.");
+        require(suppression_rows(fixture, "shabg") == 1, "Committing the raw letters was not recorded.");
+        type(*session, "shabg");
+        require(!any_corrected(*session), "A suppressed input was still corrected.");
+        require(session->preedit() == "shabg", "The preedit does not show the typed letters.");
+        cancel(*session);
+
+        type(*session, "sahng");
+        require(!session->candidates().empty() && session->candidates().front().word == "上" &&
+                    !session->candidates().front().corrected_from.empty(),
+                "The alias correction was not offered.");
+        require(session->handle_command(metasequoia::Command::CommitRaw).commit == "sahng",
+                "The raw alias letters were not committed.");
+        require(suppression_rows(fixture, "sahng") == 1, "The alias rejection was not recorded.");
+        type(*session, "sahng");
+        require(!any_corrected(*session), "A suppressed alias input was still corrected.");
+        require(session->normalized_segmentation() == "sa'h'n'g",
+                "A suppressed alias input was not cut as typed: " + session->normalized_segmentation());
+        cancel(*session);
+
+        type(*session, "sahngzhi");
+        require(any_corrected(*session), "A suppression spread to a longer input.");
+        cancel(*session);
+    }
+
+    // A session opened afterwards on the same journal honours it too.
+    {
+        auto later = make_session(fixture, kTableTypes);
+        type(*later, "shabg");
+        require(!any_corrected(*later), "A new session ignored the stored suppression.");
+        cancel(*later);
+    }
+
+    const auto off = make_fixture(root, "suppression-off");
+    {
+        auto unmasked = make_session(off, 0);
+        type(*unmasked, "sahng");
+        require(any_corrected(*unmasked), "The alias fixture offered no correction with the mask off.");
+        unmasked->handle_command(metasequoia::Command::CommitRaw);
+        auto quiet = make_session(off, kTableTypes, false);
+        type(*quiet, "shabg");
+        require(any_corrected(*quiet), "The table correction was not offered with learning off.");
+        quiet->handle_command(metasequoia::Command::CommitRaw);
+    }
+    require(query_integer(off.journal(), "SELECT count(*) FROM pinyin_autocorrect_suppressions") == 0,
+            "A suppression was recorded with the mask or learning off.");
+}
