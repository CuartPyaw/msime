+void require(bool condition, const char *message)
+{
+    if (!condition)
+        throw std::runtime_error(message);
+}
+
+void execute(const std::filesystem::path &path, const std::string &sql)
+{
+    sqlite3 *database = nullptr;
+    if (sqlite3_open(metasequoia::path_to_utf8(path).c_str(), &database) != SQLITE_OK)
+    {
+        sqlite3_close(database);
+        throw std::runtime_error("Failed to open a pick-pair fixture database.");
+    }
+    char *error = nullptr;
+    const int status = sqlite3_exec(database, sql.c_str(), nullptr, nullptr, &error);
+    const std::string message = error == nullptr ? "SQLite operation failed." : error;
+    sqlite3_free(error);
+    sqlite3_close(database);
+    if (status != SQLITE_OK)
+        throw std::runtime_error(message);
+}
+
+// 0 when the database, the table or the row is missing.
+std::int64_t query_integer(const std::filesystem::path &path, const std::string &sql,
+                           const std::vector<std::string> &arguments = {})
+{
+    if (!std::filesystem::exists(path))
+        return 0;
+    sqlite3 *database = nullptr;
+    sqlite3_stmt *statement = nullptr;
+    std::int64_t value = 0;
+    if (sqlite3_open_v2(metasequoia::path_to_utf8(path).c_str(), &database, SQLITE_OPEN_READONLY, nullptr) ==
+            SQLITE_OK &&
+        sqlite3_prepare_v2(database, sql.c_str(), -1, &statement, nullptr) == SQLITE_OK)
+    {
+        for (std::size_t i = 0; i < arguments.size(); ++i)
+            sqlite3_bind_text(statement, static_cast<int>(i + 1), arguments[i].c_str(),
+                              static_cast<int>(arguments[i].size()), SQLITE_TRANSIENT);
+        if (sqlite3_step(statement) == SQLITE_ROW)
+            value = sqlite3_column_int64(statement, 0);
+    }
+    sqlite3_finalize(statement);
+    sqlite3_close(database);
+    return value;
+}
+
+void prepare_dictionary(const std::filesystem::path &directory)
+{
+    std::filesystem::create_directories(directory);
+    execute(directory / "msime.db", "BEGIN;"
+                                    "CREATE TABLE tbl_1_s(key TEXT, jp TEXT, value TEXT, weight INTEGER);"
+                                    "INSERT INTO tbl_1_s VALUES('shan','s','闪',100),('shan','s','山',90),"
+                                    "('shui','s','睡',100),('shui','s','水',90);"
+                                    "CREATE TABLE tbl_1_x(key TEXT, jp TEXT, value TEXT, weight INTEGER);"
+                                    "INSERT INTO tbl_1_x VALUES('xing','x','行',100),('xing','x','✓',90);"
+                                    "CREATE TABLE tbl_1_h(key TEXT, jp TEXT, value TEXT, weight INTEGER);"
+                                    "INSERT INTO tbl_1_h VALUES('hao','h','好',100);"
+                                    "CREATE TABLE tbl_1_n(key TEXT, jp TEXT, value TEXT, weight INTEGER);"
+                                    "INSERT INTO tbl_1_n VALUES('ni','n','你',100);"
+                                    "CREATE TABLE tbl_1_m(key TEXT, jp TEXT, value TEXT, weight INTEGER);"
+                                    "INSERT INTO tbl_1_m VALUES('ma','m','吗',100);"
+                                    "CREATE TABLE tbl_2_s(key TEXT, jp TEXT, value TEXT, weight INTEGER);"
+                                    "CREATE TABLE tbl_2_h(key TEXT, jp TEXT, value TEXT, weight INTEGER);"
+                                    "INSERT INTO tbl_2_h VALUES('hao''hao','hh','好好',100);"
+                                    "CREATE TABLE tbl_3_n(key TEXT, jp TEXT, value TEXT, weight INTEGER);"
+                                    "INSERT INTO tbl_3_n VALUES('ni''hao''ma','nhm','你好吗',100);"
+                                    "COMMIT;");
+}
+
+RuntimePaths paths_in(const std::filesystem::path &directory)
+{
+    return {directory, directory, directory, directory};
+}
+
+std::filesystem::path journal_in(const std::filesystem::path &directory)
+{
+    return directory / "msime_user.db";
+}
+
+std::unique_ptr<InputSession> make_session(const std::filesystem::path &directory, bool learning = true,
+                                           SchemeType scheme = SchemeType::Quanpin)
+{
+    auto session = std::make_unique<InputSession>(scheme, 0, true, true, learning, paths_in(directory));
+    require(session->set_frequency_adjustment({metasequoia::FrequencyAdjustmentMode::Disabled, 1, 1}),
+            "The frequency configuration was rejected.");
+    return session;
+}
+
+void type(InputSession &session, const std::string &text)
+{
+    for (const char character : text)
+        require(session.handle_character(character).handled, "A pinyin character was not handled.");
+}
+
+void commit(InputSession &session, const std::string &pinyin, const std::string &word)
+{
+    type(session, pinyin);
+    const auto result = session.select_candidate(word);
+    require(result.handled && result.commit == word && !result.diagnostic,
+            "A fixture candidate could not be committed.");
+}
+
+std::int64_t transition_count(const std::filesystem::path &directory, const std::string &previous,
+                              const std::string &word)
+{
+    return query_integer(journal_in(directory),
+                         "SELECT count FROM pick_transitions WHERE previous_value=?1 AND value=?2", {previous, word});
+}
+
+std::int64_t transition_rows(const std::filesystem::path &directory)
+{
+    return query_integer(journal_in(directory), "SELECT COUNT(*) FROM pick_transitions");
+}
+
+bool has_word(const std::filesystem::path &directory, const std::string &table, const std::string &key,
+              const std::string &word)
+{
+    return query_integer(directory / "msime.db", "SELECT COUNT(*) FROM " + table + " WHERE key=?1 AND value=?2",
+                         {key, word}) > 0;
+}
+
+bool has_shanshui(const std::filesystem::path &directory)
+{
+    return has_word(directory, "tbl_2_s", "shan'shui", "山水");
+}
+
+std::size_t index_of(const InputSession &session, const std::string &word)
+{
+    const auto &candidates = session.candidates();
+    for (std::size_t i = 0; i < candidates.size(); ++i)
+        if (candidates[i].word == word)
+            return i;
+    throw std::runtime_error("A fixture candidate is missing.");
+}
+
+void cycle(InputSession &session)
+{
+    commit(session, "shan", "山");
+    commit(session, "shui", "水");
+}
+
+void test_pair_becomes_word(const std::filesystem::path &root)
+{
+    const auto directory = root / "learn";
+    prepare_dictionary(directory);
+    auto owned = make_session(directory);
+    auto &session = *owned;
+
+    cycle(session);
+    // The 水 that ends one cycle and the 山 that opens the next are a pair of their own.
+    require(transition_count(directory, "山", "水") == 1 && transition_count(directory, "水", "山") == 0,
+            "The first pair was not counted once.");
+    session.reset_commit_context();
+    cycle(session);
+    session.reset_commit_context();
+    require(transition_count(directory, "山", "水") == 2 && !has_shanshui(directory),
+            "Two occurrences already created the word.");
+    cycle(session);
+    require(has_shanshui(directory), "The third occurrence did not create the word.");
+    require(query_integer(journal_in(directory),
+                          "SELECT user_inserted FROM user_dictionary_operations WHERE dictionary='pinyin' AND "
+                          "key=?1 AND value=?2 AND operation='upsert'",
+                          {"shan'shui", "山水"}) == 1,
+            "The created word was not journaled as a user insert.");
+    require(transition_count(directory, "山", "水") == 0, "The counter survived the word it created.");
+
+    session.reset_commit_context();
+    type(session, "shanshui");
+    require(index_of(session, "山水") == 0, "The created word was not the first candidate of the next query.");
+    session.handle_command(metasequoia::Command::Cancel);
+}
