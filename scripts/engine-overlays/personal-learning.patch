+void test_basic_undo(Fixture &fixture)
+{
+    auto options = fixture.options();
+    Session session(options);
+    const auto before = learned_state(options, "tbl_1_n", "丙");
+    const auto personal_before = personal_state(options);
+    pick(session, "ni", "丙");
+    require(weight(options, "tbl_1_n", "丙") == 95, "The fixture pick of 丙 did not learn.");
+    require(personal_state(options) != personal_before, "The fixture pick of 丙 taught no personal context.");
+    backspace(session, 1);
+    const auto result = pick(session, "ni", "乙");
+    require(!result.diagnostic, "The undo reported a diagnostic.");
+    require(learned_state(options, "tbl_1_n", "丙") == before, "Undo did not restore every row 丙's pick wrote.");
+    require(tombstones(options) == 0, "Undo wrote a delete tombstone.");
+    // Ranked against the restored list 甲 100, 乙 90, 丙 80, not against 丙 95.
+    require(weight(options, "tbl_1_n", "乙") == 600, "乙 was not learned against the restored ranking.");
+    require(rows(journal(options), "SELECT previous,word FROM personal_bigram WHERE word='丙'").empty(),
+            "Undo left 丙's personal context.");
+    require(integer(journal(options), "SELECT count FROM personal_bigram WHERE word='乙'") == 2,
+            "The new pick's personal context is missing.");
+
+    // The replayed generation reproduces the undone state: shipped weight for 丙, the new learning for 乙.
+    const auto replayed = fixture.root / ("replay-" + std::to_string(fixture.next));
+    std::filesystem::create_directories(replayed);
+    std::filesystem::copy_file(fixture.resources / metasequoia::assets::main_dictionary, replayed / "msime.db");
+    std::filesystem::copy_file(fixture.resources / metasequoia::assets::english_dictionary, replayed / "english.db");
+    const auto replay = user_dictionary::replay(metasequoia::path_to_utf8(journal(options)),
+                                                metasequoia::path_to_utf8(replayed / "msime.db"),
+                                                metasequoia::path_to_utf8(replayed / "english.db"));
+    require(replay.error.empty() && replay.failed == 0, "Replay after an undo failed.");
+    require(integer(replayed / "msime.db", "SELECT weight FROM tbl_1_n WHERE value='丙'") == 80 &&
+                integer(replayed / "msime.db", "SELECT weight FROM tbl_1_n WHERE value='乙'") == 600,
+            "Replay after an undo did not give the undone weights.");
+}
