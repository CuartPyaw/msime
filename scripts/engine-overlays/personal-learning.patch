+void test_variant_table()
+{
+    using quanpin::SyllableTypoKind;
+    require(quanpin::syllable_typo_kind("shou", "shuo") == SyllableTypoKind::Transposition,
+            "shou -> shuo is not a transposition.");
+    require(quanpin::syllable_typo_kind("shuo", "shou") == SyllableTypoKind::Transposition,
+            "shuo -> shou did not keep the cheapest kind.");
+    require(quanpin::syllable_typo_kind("ni", "mi") == SyllableTypoKind::Neighbor, "ni -> mi is not a neighbor typo.");
+    require(quanpin::syllable_typo_kind("gan", "guan") == SyllableTypoKind::MissingOrExtra,
+            "gan -> guan is not a missing letter.");
+    require(quanpin::syllable_typo_kind("gang", "gan") == SyllableTypoKind::MissingOrExtra,
+            "gang -> gan is not an extra letter.");
+    require(!quanpin::syllable_typo_kind("ta", "da").has_value(), "t and d were treated as neighbours.");
+    require(quanpin::syllable_typos("a").empty() && quanpin::syllable_typos("e").empty(),
+            "A one-letter syllable has typo variants.");
+    require(quanpin::syllable_typos("notasyllable").empty(), "An illegal string has typo variants.");
+    for (const auto &typo : quanpin::syllable_typos("ju"))
+        require(typo.syllable != "ju" && typo.syllable != "jv", "An umlaut alias was offered as a typo of itself.");
+    for (const auto &typo : quanpin::syllable_typos("lve"))
+        require(typo.syllable != "lue" && typo.syllable != "lve", "lue was offered as a typo of lve.");
+    for (const auto &syllable : quanpin::intact_pinyin_list())
+        for (const auto &typo : quanpin::syllable_typos(syllable))
+            require(quanpin::intact_pinyin_set().count(typo.syllable) != 0, "A typo variant is not a syllable.");
+
+    // The static neighbor table and the typo edges must agree on which keys are neighbours.
+    for (const auto &entry : quanpin::autocorrect::kNeighborEntries)
+    {
+        const std::string wrong = entry.wrong;
+        const std::string correct(quanpin::autocorrect::kCorrectSyllables[entry.correct]);
+        require(wrong.size() == correct.size(), "A neighbor entry changes length: " + wrong);
+        int substitutions = 0;
+        bool adjacent = true;
+        for (std::size_t i = 0; i < wrong.size(); ++i)
+        {
+            if (wrong[i] == correct[i])
+                continue;
+            ++substitutions;
+            adjacent = adjacent && quanpin::keys_adjacent(wrong[i], correct[i]);
+        }
+        require(substitutions == 1 && adjacent, "The neighbor table disagrees with keys_adjacent: " + wrong);
+    }
+    require(quanpin::keys_adjacent('n', 'm') && quanpin::keys_adjacent('a', 'q') && quanpin::keys_adjacent('z', 's'),
+            "Neighbouring keys were not adjacent.");
+    require(!quanpin::keys_adjacent('a', 'a') && !quanpin::keys_adjacent('q', 'z') && !quanpin::keys_adjacent('l', 'm'),
+            "Distant keys were adjacent.");
+}
