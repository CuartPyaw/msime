+    void refresh_if_changed();
+
+    int accepted(const std::string &typed, const std::string &intended) const;
+    bool suppressed(const std::string &folded_input) const;
+
+    // Persists one acceptance per pair, then applies it in memory. Pairs that are not a single-edit syllable typo are
+    // rejected together with the rest of the batch. With `delta`, the acceptance is recorded for learning undo.
+    bool record_accepted(const std::vector<std::pair<std::string, std::string>> &pairs,
+                         user_dictionary::LearningDelta *delta = nullptr);
+    bool record_suppression(const std::string &folded_input);
+
+    // Changes whenever the held state changes, so caches built from it can be dropped.
+    std::uint64_t generation() const
+    {
+        return generation_.load(std::memory_order_acquire);
+    }
+
+    // The penalty of a typo edge after `accepted` acceptances of the same pair. A subtractive discount of up to three
+    // log units on a base of about five, scaled to the lattice's edge scale, so it never drops below 40% of base.
+    static double discounted(double base, int accepted);
+
+  private:
+    struct FileStamp
+    {
+        bool exists = false;
+
+        std::filesystem::file_time_type written{};
+
+        std::uintmax_t size = 0;
+
+        bool operator==(const FileStamp &other) const
+        {
+            return exists == other.exists && written == other.written && size == other.size;
+        }
+    };
+
+    explicit PersonalTypoProfile(std::filesystem::path user_db);
+
+    std::pair<FileStamp, FileStamp> current_stamp() const;
+    std::shared_ptr<const user_dictionary::PinyinTypoState> snapshot() const;
+    // After a write of ours: reads the journal back, since the write may also have trimmed rows the snapshot holds.
+    // Falls back to `patch` on the held state when the read fails. Caller holds writer_mutex_.
+    void reload_after_write(const std::function<void(user_dictionary::PinyinTypoState &)> &patch);
+    void replace(std::shared_ptr<const user_dictionary::PinyinTypoState> state);
+
+    const std::filesystem::path path_;
+
+    const std::string path_utf8_;
+
+    // Serialises reloads and writes so an in-memory update is never lost to a reload that read the file before it.
+    std::mutex writer_mutex_;
+
+    mutable std::mutex snapshot_mutex_;
+
+    std::shared_ptr<const user_dictionary::PinyinTypoState> state_;
+
+    std::atomic<std::uint64_t> generation_{0};
+
+    // Stamps of the journal and its WAL seen by the last successful load. Guarded by writer_mutex_.
+    bool loaded_ = false;
+
+    std::pair<FileStamp, FileStamp> loaded_stamp_;
+};
