+        pick(session, "wode", "沃德");
+        require(!session.character('6').commit && !session.character('4').commit, "The grid committed early.");
+        require(!session.snapshot().nine_key_spellings.empty(), "The digits did not open the grid.");
+        const auto result = session.punctuation(',');
+        require(result.handled && result.commit && result.commit->size() > std::string("，").size(),
+                "Punctuation did not finish the grid composition.");
+        // The grid text and the punctuation form one record, so 沃德 is fully deleted only by the second Backspace past
+        // it; a punctuation record counted twice would need one more.
+        const int inserted = static_cast<int>(HelpcodeUtils::count_utf8_chars(*result.commit));
+        backspace(session, inserted + 1 + extra);
+        pick(session, "wode", "我的");
+        require(weight(options, "tbl_2_w", "沃德") == (extra == 0 ? 1500 : 900),
+                "The grid and punctuation text were not counted once, in order.");
+    }
+}
