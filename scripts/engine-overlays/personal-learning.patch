+// Records one committed run of words, each word counted `times`.
+void record_run(PersonalNgram &model, const std::vector<std::string> &words, std::uint32_t times = 1)
+{
+    std::string earlier;
+    std::string previous;
+    for (const auto &word : words)
+    {
+        model.add(transition(earlier, previous, word, times));
+        earlier = previous;
+        previous = word;
+    }
+}
