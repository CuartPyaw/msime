+std::unique_ptr<InputSession> make_session(const Fixture &fixture, unsigned mask, bool learning = true)
+{
+    auto session = std::make_unique<InputSession>(SchemeType::Quanpin, mask, false, true, learning, fixture.paths());
+    require(session->set_frequency_adjustment({metasequoia::FrequencyAdjustmentMode::Disabled, 1, 1}),
+            "The frequency configuration was rejected.");
+    return session;
+}
+
+void type(InputSession &session, const std::string &text)
+{
+    for (const char character : text)
+        require(session.handle_character(character).handled, "A pinyin character was not handled.");
+}
+
+void cancel(InputSession &session)
+{
+    session.handle_command(metasequoia::Command::Cancel);
+}
+
+// Index of the row that reads the input as a typo sentence, or -1.
+int typo_row(const InputSession &session)
+{
+    const auto &candidates = session.candidates();
+    for (std::size_t i = 0; i < candidates.size(); ++i)
+    {
+        if (candidates[i].sentence_association && !candidates[i].corrected_from.empty())
+            return static_cast<int>(i);
+    }
+    return -1;
+}
+
+int index_of(const InputSession &session, const std::string &word)
+{
+    const auto &candidates = session.candidates();
+    for (std::size_t i = 0; i < candidates.size(); ++i)
+    {
+        if (candidates[i].word == word)
+            return static_cast<int>(i);
+    }
+    return -1;
+}
+
+bool any_corrected(const InputSession &session)
+{
+    const auto &candidates = session.candidates();
+    return std::any_of(candidates.begin(), candidates.end(),
+                       [](const WordItem &item) { return !item.corrected_from.empty(); });
+}
+
+std::vector<std::string> words_of(const InputSession &session)
+{
+    std::vector<std::string> words;
+    for (const auto &item : session.candidates())
+        words.push_back(item.word);
+    return words;
+}
