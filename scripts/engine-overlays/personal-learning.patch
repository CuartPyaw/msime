+void test_concurrent_reload(const std::filesystem::path &root)
+{
+    const auto directory = root / "threads";
+    std::filesystem::create_directories(directory);
+    auto &store = PersonalNgramStore::for_journal(metasequoia::path_to_utf8(journal_in(directory)));
+    std::atomic<bool> failed{false};
+    std::vector<std::thread> threads;
+    for (int reader = 0; reader < 3; ++reader)
+    {
+        threads.emplace_back([&store, &failed] {
+            for (int i = 0; i < 300; ++i)
+            {
+                const auto view = store.read();
+                const double p = view.model().probability(start(), "甲", "乙");
+                if (!(p >= 0.0 && p <= 1.0))
+                    failed = true;
+            }
+        });
+    }
+    threads.emplace_back([&store, &failed] {
+        for (int i = 0; i < 100; ++i)
+            if (!store.record({transition("", "甲", "乙", 1)}))
+                failed = true;
+    });
+    for (int i = 0; i < 50; ++i)
+        user_dictionary::close_default_user_database();
+    for (auto &thread : threads)
+        thread.join();
+    require(!failed, "Concurrent reads, writes and reloads produced an invalid result.");
+    user_dictionary::close_default_user_database();
+    require(pair_count(journal_in(directory), "甲", "乙") == 100 &&
+                store.read().model().bigram_probability("甲", "乙") > 0.0,
+            "Concurrent writes lost or double-counted a transition.");
+}
