+struct Fixture
+{
+    std::filesystem::path root;
+
+    std::filesystem::path resources;
+
+    int next = 0;
+
+    SessionOptions options(bool undo = true)
+    {
+        const auto user = root / ("user-" + std::to_string(next));
+        const auto cache = root / ("cache-" + std::to_string(next));
+        ++next;
+        SessionOptions result;
+        result.paths = metasequoia::prepare_runtime_paths(resources, user, cache, "v1");
+        result.frequency = {metasequoia::FrequencyAdjustmentMode::Halve, 1, 1};
+        result.learning_undo = undo;
+        return result;
+    }
+};
