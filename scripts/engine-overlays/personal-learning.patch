+void insert_word(const std::filesystem::path &database, const std::string &key, const std::string &word,
+                 std::int64_t weight)
+{
+    const auto table = quanpin::build_table_name(quanpin::split_segments(key));
+    require(!table.empty(), "The fixture key has no table: " + key);
+    execute(database, "CREATE TABLE IF NOT EXISTS " + table +
+                          "(key TEXT, jp TEXT, value TEXT, weight INTEGER);"
+                          "INSERT INTO " +
+                          table + " VALUES('" + escaped(key) + "','','" + word + "'," + std::to_string(weight) + ");");
+}
+
+Fixture make_fixture(const std::filesystem::path &root, const std::string &name, bool strong_literal_phrase = false)
+{
+    Fixture fixture{root / name / "dictionary", root / name / "user"};
+    std::filesystem::create_directories(fixture.dictionary);
+    std::filesystem::create_directories(fixture.user);
+    const auto database = fixture.dictionary / "msime.db";
+    insert_word(database, "mei", "没", 1000);
+    insert_word(database, "mei", "美", 900);
+    insert_word(database, "gan", "干", 1000);
+    insert_word(database, "guan", "关", 500);
+    insert_word(database, "xi", "系", 1000);
+    insert_word(database, "guan'xi", "关系", 100000);
+    if (strong_literal_phrase)
+        insert_word(database, "gan'xi", "干系", 200000);
+    insert_word(database, "shang", "上", 1000);
+    insert_word(database, "sang", "桑", 900);
+    insert_word(database, "shang'zhi", "上知", 100);
+    insert_word(database, "zhi", "知", 100);
+    // Where a selected sentence is stored.
+    execute(database, "CREATE TABLE IF NOT EXISTS " + quanpin::build_table_name({"mei", "guan", "xi"}) +
+                          "(key TEXT, jp TEXT, value TEXT, weight INTEGER);");
+    return fixture;
+}
