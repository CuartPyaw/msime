+#!/usr/bin/env python3
+"""Turn a whole-sentence eval set into a typo eval set for `eval_sentences --autocorrect-types`.
+
+Reads `pinyin<TAB>sentence` rows, reads each sentence back into syllables the way build_eval_set.py does, replaces one syllable with a one-edit typo that is itself a legal syllable (an adjacent transposition, a neighbouring QWERTY key, or a missing or extra letter), and writes `typo_pinyin<TAB>sentence`. The sentence stays the expected answer, so the set measures how often the engine recovers what was meant.
+
+Rows whose reading does not reproduce the original pinyin, or that have no syllable with a legal typo of an enabled kind, are dropped. The random choices use a fixed seed, so the same inputs always give the same set.
+
+Usage:
+    build_typo_eval_set.py --dictionary out/msime.db --out typos.tsv sentences-v1.tsv [--kinds transposition,neighbor,missing]
+"""
+
+from __future__ import annotations
+
+import argparse
+import random
+import sqlite3
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from build_eval_set import load_readings, needed_substrings, read_sentence  # noqa: E402
+
+KEYBOARD_ROWS = ["qwertyuiop", "asdfghjkl", "zxcvbnm"]
+KINDS = ("transposition", "neighbor", "missing")
+SEED = 20260929
+
+
+def key_position(key: str) -> tuple[int, int] | None:
+    for row, keys in enumerate(KEYBOARD_ROWS):
+        column = keys.find(key)
+        if column >= 0:
+            return row, column
+    return None
+
+
+def keys_adjacent(a: str, b: str) -> bool:
+    """Same layout as quanpin::keys_adjacent: each lower row sits half a key right of the row above."""
+    first, second = key_position(a), key_position(b)
+    if a == b or first is None or second is None:
+        return False
+    if first[0] == second[0]:
+        return abs(first[1] - second[1]) == 1
+    upper, lower = sorted([first, second])
+    return lower[0] == upper[0] + 1 and upper[1] in (lower[1], lower[1] + 1)
+
+
+def legal_syllables(database: Path) -> set[str]:
+    connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
+    tables = [row[0] for row in connection.execute("select name from sqlite_master where type='table' and name like 'tbl_1_%'")]
+    syllables: set[str] = set()
+    for table in tables:
+        for (key,) in connection.execute(f"select distinct key from {table}"):  # noqa: S608 - table names come from sqlite_master
+            if key and key.isalpha() and key.islower():
+                syllables.add(key)
+    connection.close()
+    return syllables
+
+
+def typos_of(syllable: str, legal: set[str], kinds: set[str]) -> list[str]:
+    """Every legal one-edit typo of `syllable` of an enabled kind, in a stable order."""
+    if len(syllable) < 2:
+        return []
+    found: list[str] = []
+
+    def add(candidate: str) -> None:
+        if len(candidate) >= 2 and candidate != syllable and candidate in legal and candidate not in found:
+            found.append(candidate)
+
+    if "transposition" in kinds:
+        for i in range(len(syllable) - 1):
+            if syllable[i] != syllable[i + 1]:
+                add(syllable[:i] + syllable[i + 1] + syllable[i] + syllable[i + 2 :])
+    if "neighbor" in kinds:
+        for i, letter in enumerate(syllable):
+            for key in "abcdefghijklmnopqrstuvwxyz":
+                if keys_adjacent(key, letter):
+                    add(syllable[:i] + key + syllable[i + 1 :])
+    if "missing" in kinds:
+        for i in range(len(syllable)):
+            add(syllable[:i] + syllable[i + 1 :])
+        for i in range(len(syllable) + 1):
+            for key in "abcdefghijklmnopqrstuvwxyz":
+                add(syllable[:i] + key + syllable[i:])
+    return found
+
+
+def load_rows(path: Path) -> list[tuple[str, str]]:
+    """`pinyin<TAB>sentence` rows, or the `id<TAB>input<TAB>gold<TAB>...` layout with a header row."""
+    rows: list[tuple[str, str]] = []
+    columns = (0, 1)
+    for line in path.read_text(encoding="utf-8").splitlines():
+        if line.startswith("#") or "\t" not in line:
+            continue
+        fields = line.split("\t")
+        if fields[:3] == ["id", "input", "gold"]:
+            columns = (1, 2)
+            continue
+        if len(fields) <= columns[1]:
+            continue
+        pinyin, sentence = fields[columns[0]], fields[columns[1]]
+        if pinyin and sentence:
+            rows.append((pinyin, sentence))
+    return rows
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("inputs", nargs="+", type=Path, help="eval TSVs to derive typo rows from")
+    parser.add_argument("--dictionary", required=True, type=Path, help="path to msime.db")
+    parser.add_argument("--out", required=True, type=Path, help="TSV to write")
+    parser.add_argument("--kinds", default=",".join(KINDS), help=f"comma-separated subset of {', '.join(KINDS)}")
+    args = parser.parse_args()
+
+    kinds = {kind.strip() for kind in args.kinds.split(",") if kind.strip()}
+    if not kinds or not kinds <= set(KINDS):
+        print(f"--kinds must be a subset of {', '.join(KINDS)}", file=sys.stderr)
+        return 2
+    if not args.dictionary.is_file():
+        print(f"no dictionary at {args.dictionary}", file=sys.stderr)
+        return 1
+
+    rows = [row for path in args.inputs for row in load_rows(path)]
+    legal = legal_syllables(args.dictionary)
+    readings = load_readings(args.dictionary, needed_substrings([sentence for _, sentence in rows]))
+    generator = random.Random(SEED)
+
+    written: list[tuple[str, str]] = []
+    dropped = 0
+    for pinyin, sentence in rows:
+        syllables = read_sentence(sentence, readings)
+        if syllables is None or "".join(syllables) != pinyin:
+            dropped += 1
+            continue
+        options = [(index, typo) for index, syllable in enumerate(syllables) for typo in typos_of(syllable, legal, kinds)]
+        if not options:
+            dropped += 1
+            continue
+        index, typo = generator.choice(options)
+        edited = syllables[:index] + [typo] + syllables[index + 1 :]
+        written.append(("".join(edited), sentence))
+
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    with args.out.open("w", encoding="utf-8") as handle:
+        for pinyin, sentence in written:
+            handle.write(f"{pinyin}\t{sentence}\n")
+    print(f"{len(rows)} rows -> {len(written)} typo rows, {dropped} dropped")
+    print(f"wrote {args.out}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
