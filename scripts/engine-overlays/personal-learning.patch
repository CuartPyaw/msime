+void test_transactions_and_caps(const std::filesystem::path &root)
+{
+    const auto fixture = make_fixture(root, "caps");
+    const std::string journal = metasequoia::path_to_utf8(fixture.journal());
+    require(!user_dictionary::record_pinyin_typos(journal, {{"gan", "guan"}, {"", "x"}}),
+            "A batch with an invalid pair was accepted.");
+    require(typo_count(fixture, "gan", "guan") == 0, "A rejected batch wrote a row.");
+    require(!user_dictionary::record_autocorrect_suppression(journal, "Sa'hng"), "An unfolded input was accepted.");
+
+    require(user_dictionary::record_pinyin_typos(journal, {{"gan", "guan"}}), "A valid batch was rejected.");
+    std::string typo_rows;
+    for (int i = 0; i < 2100; ++i)
+    {
+        std::string code;
+        for (int n = i, digit = 0; digit < 3; ++digit, n /= 26)
+            code.push_back(static_cast<char>('a' + n % 26));
+        typo_rows += std::string(typo_rows.empty() ? "" : ",") + "('" + code + "','" + code + "z',1)";
+    }
+    execute(fixture.journal(), "INSERT INTO pinyin_typo_counts(typed,intended,accepted) VALUES" + typo_rows + ";");
+    require(user_dictionary::record_pinyin_typos(journal, {{"sahng", "shang"}, {"gan", "guan"}}),
+            "A valid batch over a full table was rejected.");
+    require(query_integer(fixture.journal(), "SELECT count(*) FROM pinyin_typo_counts") == 2048,
+            "The typo count table was not trimmed to its cap.");
+    require(typo_count(fixture, "sahng", "shang") == 1 && typo_count(fixture, "gan", "guan") == 2,
+            "Trimming dropped a pair the batch had just recorded.");
+
+    std::string rows;
+    for (int i = 0; i < 2100; ++i)
+        rows += std::string(rows.empty() ? "" : ",") + "('input" + std::to_string(i) + "',1)";
+    execute(fixture.journal(), "INSERT INTO pinyin_autocorrect_suppressions(input,commits) VALUES" + rows + ";");
+    require(user_dictionary::record_autocorrect_suppression(journal, "shabg"), "A suppression was rejected.");
+    require(query_integer(fixture.journal(), "SELECT count(*) FROM pinyin_autocorrect_suppressions") == 2048,
+            "The suppression table was not trimmed to its cap.");
+
+    const auto legacy = make_fixture(root, "legacy");
+    execute(legacy.journal(), "CREATE TABLE user_dictionary_operations(dictionary TEXT NOT NULL,key TEXT NOT NULL,"
+                              "value TEXT NOT NULL,operation TEXT NOT NULL,weight INTEGER NOT NULL DEFAULT 0,"
+                              "display TEXT NOT NULL DEFAULT '',user_inserted INTEGER NOT NULL DEFAULT 0,"
+                              "updated_at INTEGER NOT NULL DEFAULT(unixepoch()),PRIMARY KEY(dictionary,key,value));"
+                              "INSERT INTO user_dictionary_operations(dictionary,key,value,operation,weight)"
+                              " VALUES('pinyin','guan''xi','关系','upsert',5);"
+                              "PRAGMA user_version=3;");
+    const auto state = user_dictionary::load_pinyin_typo_state(metasequoia::path_to_utf8(legacy.journal()));
+    require(state.has_value() && state->accepted.empty() && state->suppressed.empty(),
+            "A journal without typo tables did not read as empty.");
+    require(user_dictionary::ensure_user_database(metasequoia::path_to_utf8(legacy.journal())),
+            "The version 3 journal could not be upgraded.");
+    require(query_integer(legacy.journal(), "SELECT count(*) FROM user_dictionary_operations") == 1,
+            "Upgrading the journal lost a row.");
+    require(query_integer(legacy.journal(), "SELECT count(*) FROM pinyin_typo_counts") == 0 &&
+                query_integer(legacy.journal(), "PRAGMA user_version") == 4,
+            "The upgrade did not create the typo tables.");
+
+    const auto missing =
+        user_dictionary::load_pinyin_typo_state(metasequoia::path_to_utf8(root / "caps" / "nowhere" / "msime_user.db"));
+    require(missing.has_value() && missing->accepted.empty(), "A missing journal did not read as empty.");
+    require(!std::filesystem::exists(root / "caps" / "nowhere"), "Loading the typo state created files.");
+}
