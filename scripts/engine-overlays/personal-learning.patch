+#pragma once
+
+#include "user_dictionary_journal.h"
+#include "../quanpin/personal_ngram.h"
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+struct sqlite3;
+
+namespace user_dictionary
+{
+// Every column of a user_dictionary_operations row that a restore has to put back. updated_at and rowid decide replay
+// order, so a restored row keeps both.
+struct JournalRowImage
+{
+    std::string operation;
+
+    std::int64_t weight = 0;
+
+    std::string display;
+
+    int user_inserted = 0;
+
+    std::int64_t updated_at = 0;
+
+    bool operator==(const JournalRowImage &other) const
+    {
+        return operation == other.operation && weight == other.weight && display == other.display &&
+               user_inserted == other.user_inserted && updated_at == other.updated_at;
+    }
+};
+
+// One dictionary entry a learning write touched: its working-dictionary weight and its journal row, as they were before
+// the write and as the write left them. nullopt means the row did not exist.
+struct DictionaryRowChange
+{
+    DictionaryKind kind = DictionaryKind::Pinyin;
+
+    std::string key;
+
+    std::string value;
+
+    std::optional<std::int64_t> weight_before;
+
+    std::optional<std::int64_t> weight_after;
+
+    std::optional<JournalRowImage> journal_before;
+
+    std::optional<JournalRowImage> journal_after;
+};
+
+struct SelectionCountChange
+{
+    std::string context_key;
+
+    std::string entry_key;
+
+    std::string value;
+
+    std::optional<std::int64_t> before;
+
+    std::optional<std::int64_t> after;
+};
+
+struct PickTransitionImage
+{
+    std::int64_t count = 0;
+
+    std::int64_t updated_at = 0;
+
+    bool operator==(const PickTransitionImage &other) const
+    {
+        return count == other.count && updated_at == other.updated_at;
+    }
+};
+
+struct PickTransitionChange
+{
+    std::string previous_key;
+
+    std::string previous_value;
+
+    std::string key;
+
+    std::string value;
+
+    std::optional<PickTransitionImage> before;
+
+    std::optional<PickTransitionImage> after;
+};
+
+// What one commit taught the user's databases. Weights are absolute and neighbouring rows get rebalanced, so the
+// learning is recorded as row images to put back rather than as amounts to subtract; only the personal context
+// counters, which are pure counts, are taken back by subtraction.
+struct LearningDelta
+{
+    std::vector<DictionaryRowChange> rows;
+
+    std::vector<SelectionCountChange> selections;
+
+    std::vector<PickTransitionChange> picks;
+
+    std::vector<quanpin::PersonalTransition> contexts;
+
+    // Accepted syllable typos, one entry per acceptance; like the context counters they are taken back by subtraction.
+    std::vector<PinyinTypoPair> typos;
+
+    // Cleared when the commit wrote something these images cannot describe; such a commit gets no receipt.
+    bool complete = true;
+
+    bool empty() const
+    {
+        return rows.empty() && selections.empty() && picks.empty() && contexts.empty() && typos.empty();
+    }
+};
+
+// For a row already in `into`, the first image before the commit and the last image after it are kept.
+void merge_delta(LearningDelta &into, LearningDelta from);
+
+struct LearningReceipt
+{
+    std::string main_db_path;
+
+    std::string english_db_path;
+
+    std::string user_db_path;
+
+    LearningDelta delta;
+};
+
+enum class UndoOutcome
+{
+    Restored,
+    // A row changed after the commit wrote it (another session, a pin, a removal, an import). Nothing was put back,
+    // because that would roll the later write back too; the personal context counts were still subtracted.
+    Superseded,
+    Failed,
+};
+
+// Puts every row of the receipt back to its image before the commit in one transaction over the working dictionaries
+// and the attached journal, but only if every row still matches its image after the commit.
+UndoOutcome restore_learning_receipt(const LearningReceipt &receipt);
+
+// Row reads for the writers, run on the caller's connection inside the caller's transaction. `schema` names the
+// database holding the table ("main" for the connection's own file). False on a read error.
+bool read_dictionary_weight(sqlite3 *database, const std::string &schema, DictionaryKind kind, const std::string &key,
+                            const std::string &value, std::optional<std::int64_t> &weight);
+bool read_journal_row(sqlite3 *database, const std::string &schema, DictionaryKind kind, const std::string &key,
+                      const std::string &value, std::optional<JournalRowImage> &row);
+bool read_selection_count(sqlite3 *database, const std::string &schema, const std::string &context_key,
+                          const std::string &entry_key, const std::string &value, std::optional<std::int64_t> &count);
+bool read_pick_transition(sqlite3 *database, const std::string &schema, const std::string &previous_key,
+                          const std::string &previous_value, const std::string &key, const std::string &value,
+                          std::optional<PickTransitionImage> &image);
+} // namespace user_dictionary
