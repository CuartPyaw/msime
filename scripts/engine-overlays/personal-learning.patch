+int main()
+{
+    const auto root = std::filesystem::temp_directory_path() /
+                      ("msime-typo-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+    metasequoia::test::ScopedDataDirectoryCleanup cleanup(root);
+    try
+    {
+        test_variant_table();
+        test_gating(root);
+        test_noisy_channel(root);
+        test_learning(root);
+        test_transactions_and_caps(root);
+        test_suppression(root);
+        test_mask_cache(root);
+        test_upgrade_survival(root);
+    }
+    catch (const std::exception &error)
+    {
+        std::fprintf(stderr, "%s\n", error.what());
+        return 1;
+    }
+    return 0;
+}
