+
+namespace quanpin
+{
+namespace
+{
+constexpr int kMaxAcceptedCount = 1000;
+
+struct Registry
+{
+    std::mutex mutex;
+
+    std::map<std::string, std::weak_ptr<PersonalTypoProfile>> profiles;
+};
+
+Registry &registry()
+{
+    // Never destroyed: a session on another thread may still resolve its profile while static destructors run.
+    static Registry *instance = new Registry;
+    return *instance;
+}
+} // namespace
+
+std::shared_ptr<PersonalTypoProfile> PersonalTypoProfile::shared(const std::filesystem::path &user_db)
+{
+    auto &instance = registry();
+    std::shared_ptr<PersonalTypoProfile> profile;
+    {
+        std::lock_guard<std::mutex> lock(instance.mutex);
+        auto &slot = instance.profiles[metasequoia::path_to_utf8(user_db)];
+        profile = slot.lock();
+        if (profile)
+            return profile;
+        profile = std::shared_ptr<PersonalTypoProfile>(new PersonalTypoProfile(user_db));
+        slot = profile;
+    }
+    // A new profile loads here, while the session is being created, rather than on its first keystroke.
+    profile->refresh_if_changed();
+    return profile;
+}
+
+PersonalTypoProfile::PersonalTypoProfile(std::filesystem::path user_db)
+    : path_(std::move(user_db)), path_utf8_(metasequoia::path_to_utf8(path_)),
+      state_(std::make_shared<const user_dictionary::PinyinTypoState>())
+{
+}
+
+std::pair<PersonalTypoProfile::FileStamp, PersonalTypoProfile::FileStamp> PersonalTypoProfile::current_stamp() const
+{
+    const auto stamp = [](const std::filesystem::path &path) {
+        FileStamp result;
+        std::error_code error;
+        result.written = std::filesystem::last_write_time(path, error);
+        if (error)
+            return FileStamp{};
+        result.size = std::filesystem::file_size(path, error);
+        if (error)
+            return FileStamp{};
+        result.exists = true;
+        return result;
+    };
+    std::filesystem::path wal = path_;
+    wal += "-wal";
+    return {stamp(path_), stamp(wal)};
+}
+
+std::shared_ptr<const user_dictionary::PinyinTypoState> PersonalTypoProfile::snapshot() const
+{
+    std::lock_guard<std::mutex> lock(snapshot_mutex_);
+    return state_;
+}
+
+void PersonalTypoProfile::replace(std::shared_ptr<const user_dictionary::PinyinTypoState> state)
+{
+    {
+        std::lock_guard<std::mutex> lock(snapshot_mutex_);
+        state_ = std::move(state);
+    }
+    generation_.fetch_add(1, std::memory_order_acq_rel);
+}
+
+void PersonalTypoProfile::reload_after_write(const std::function<void(user_dictionary::PinyinTypoState &)> &patch)
+{
+    const auto stamp = current_stamp();
+    if (auto loaded = user_dictionary::load_pinyin_typo_state(path_utf8_))
+    {
+        loaded_ = true;
+        loaded_stamp_ = stamp;
+        if (!(*loaded == *snapshot()))
+            replace(std::make_shared<const user_dictionary::PinyinTypoState>(std::move(*loaded)));
+        return;
+    }
+    auto state = std::make_shared<user_dictionary::PinyinTypoState>(*snapshot());
+    patch(*state);
+    replace(std::move(state));
+}
+
+void PersonalTypoProfile::refresh_if_changed()
+{
+    std::lock_guard<std::mutex> lock(writer_mutex_);
+    const auto stamp = current_stamp();
+    if (loaded_ && stamp == loaded_stamp_)
+        return;
+    auto loaded = user_dictionary::load_pinyin_typo_state(path_utf8_);
+    // A journal that exists but cannot be read keeps the held state; the unchanged stamp retries on the next query.
+    if (!loaded)
+        return;
+    loaded_ = true;
+    loaded_stamp_ = stamp;
+    if (*loaded == *snapshot())
+        return;
+    replace(std::make_shared<const user_dictionary::PinyinTypoState>(std::move(*loaded)));
+}
+
+int PersonalTypoProfile::accepted(const std::string &typed, const std::string &intended) const
+{
+    const auto state = snapshot();
+    const auto found = state->accepted.find({typed, intended});
+    return found == state->accepted.end() ? 0 : found->second;
+}
+
+bool PersonalTypoProfile::suppressed(const std::string &folded_input) const
+{
+    const auto state = snapshot();
+    return !state->suppressed.empty() && state->suppressed.count(folded_input) != 0;
+}
+
+bool PersonalTypoProfile::record_accepted(const std::vector<std::pair<std::string, std::string>> &pairs,
+                                          user_dictionary::LearningDelta *delta)
+{
+    std::vector<user_dictionary::PinyinTypoPair> batch;
+    batch.reserve(pairs.size());
+    for (const auto &[typed, intended] : pairs)
+    {
+        if (!syllable_typo_kind(typed, intended).has_value())
+            return false;
+        batch.push_back({typed, intended});
+    }
+    std::lock_guard<std::mutex> lock(writer_mutex_);
+    if (!user_dictionary::record_pinyin_typos(path_utf8_, batch, delta))
+        return false;
+    reload_after_write([&pairs](user_dictionary::PinyinTypoState &state) {
+        for (const auto &pair : pairs)
+        {
+            int &count = state.accepted[pair];
+            count = (std::min)(count + 1, kMaxAcceptedCount);
+        }
+    });
+    return true;
+}
+
+bool PersonalTypoProfile::record_suppression(const std::string &folded_input)
+{
+    std::lock_guard<std::mutex> lock(writer_mutex_);
+    if (!user_dictionary::record_autocorrect_suppression(path_utf8_, folded_input))
+        return false;
+    reload_after_write(
+        [&folded_input](user_dictionary::PinyinTypoState &state) { state.suppressed.insert(folded_input); });
+    return true;
+}
+
+double PersonalTypoProfile::discounted(double base, int accepted)
+{
+    if (accepted <= 0)
+        return base;
+    return base - (base / 5.0) * (std::min)(std::log1p(static_cast<double>(accepted)), 3.0);
+}
+
+std::string autocorrect_suppression_key(const std::string &raw_input, const std::string &raw_input_with_cases)
+{
+    std::string key;
+    for (const char character : strip_active_helpcodes(raw_input, raw_input_with_cases))
+    {
+        if (character != '\'')
+            key.push_back(static_cast<char>(std::tolower(static_cast<unsigned char>(character))));
+    }
+    return key;
+}
