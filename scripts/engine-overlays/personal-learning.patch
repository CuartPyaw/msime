+std::optional<PinyinTypoState> load_pinyin_typo_state(const std::string &user_db_path)
+{
+    PinyinTypoState state;
+    std::error_code error;
+    if (!std::filesystem::exists(metasequoia::path_from_utf8(user_db_path.c_str()), error))
+        return error ? std::nullopt : std::optional<PinyinTypoState>(std::move(state));
+    auto db = open_database(user_db_path, SQLITE_OPEN_READONLY);
+    if (!db)
+        return std::nullopt;
+    if (table_exists(db.get(), "pinyin_typo_counts"))
+    {
+        auto stmt = prepare(db.get(), "SELECT typed,intended,accepted FROM pinyin_typo_counts WHERE accepted > 0");
+        if (!stmt)
+            return std::nullopt;
+        int status = SQLITE_ROW;
+        while ((status = sqlite3_step(stmt.get())) == SQLITE_ROW)
+        {
+            const auto *typed = sqlite3_column_text(stmt.get(), 0);
+            const auto *intended = sqlite3_column_text(stmt.get(), 1);
+            if (typed == nullptr || intended == nullptr)
+                continue;
+            state.accepted[{reinterpret_cast<const char *>(typed), reinterpret_cast<const char *>(intended)}] =
+                sqlite3_column_int(stmt.get(), 2);
+        }
+        if (status != SQLITE_DONE)
+            return std::nullopt;
+    }
+    if (table_exists(db.get(), "pinyin_autocorrect_suppressions"))
+    {
+        auto stmt = prepare(db.get(), "SELECT input FROM pinyin_autocorrect_suppressions");
+        if (!stmt)
+            return std::nullopt;
+        int status = SQLITE_ROW;
+        while ((status = sqlite3_step(stmt.get())) == SQLITE_ROW)
+        {
+            if (const auto *input = sqlite3_column_text(stmt.get(), 0))
+                state.suppressed.insert(reinterpret_cast<const char *>(input));
+        }
+        if (status != SQLITE_DONE)
+            return std::nullopt;
+    }
+    return state;
+}
