+void test_upgrade_survival(const std::filesystem::path &root)
+{
+    const auto fixture = make_fixture(root, "upgrade");
+    {
+        auto session = make_session(fixture, kAllTypes);
+        type(*session, "meiganxi");
+        require(session->select_candidate("没关系").handled, "The typo sentence could not be committed.");
+        type(*session, "shabg");
+        session->handle_command(metasequoia::Command::CommitRaw);
+    }
+    const auto next = make_fixture(root, "upgrade-next");
+    const auto replayed = user_dictionary::replay(metasequoia::path_to_utf8(fixture.journal()),
+                                                  metasequoia::path_to_utf8(next.dictionary / "msime.db"),
+                                                  metasequoia::path_to_utf8(next.dictionary / "english.db"));
+    require(replayed.failed == 0 && replayed.error.empty(), "Replaying the journal failed.");
+
+    Fixture upgraded{next.dictionary, fixture.user};
+    auto session = make_session(upgraded, kAllTypes);
+    type(*session, "shabg");
+    require(!any_corrected(*session), "The suppression did not survive the new generation.");
+    cancel(*session);
+    require(quanpin::PersonalTypoProfile::shared(upgraded.journal())->accepted("gan", "guan") == 1,
+            "The typo count did not survive the new generation.");
+}
