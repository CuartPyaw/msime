+#include "personal_ngram.h"
+#include "ngram_table.h"
+
+#include <algorithm>
+#include <limits>
+#include <utility>
+
+namespace quanpin
+{
+namespace
+{
+
+constexpr std::uint64_t kFnvOffset = 0xCBF29CE484222325ULL;
+constexpr std::uint64_t kFnvPrime = 0x100000001B3ULL;
+
+std::uint64_t mix(std::uint64_t state, const std::string &text)
+{
+    for (const unsigned char byte : text)
+    {
+        state ^= byte;
+        state *= kFnvPrime;
+    }
+    return state;
+}
+
+// The NUL between words; xor with zero is a no-op, so only the multiply remains.
+std::uint64_t separate(std::uint64_t state)
+{
+    return state * kFnvPrime;
+}
+
+std::uint64_t key_of(const std::string &word)
+{
+    return mix(kFnvOffset, word);
+}
+
+std::uint64_t key_of(const std::string &previous, const std::string &word)
+{
+    return mix(separate(key_of(previous)), word);
+}
+
+std::uint64_t key_of(const std::string &earlier, const std::string &previous, const std::string &word)
+{
+    return mix(separate(key_of(earlier, previous)), word);
+}
+
+std::uint64_t slot_key(std::uint64_t key)
+{
+    return key == 0 ? 1 : key;
+}
+
+std::uint32_t saturating_add(std::uint32_t value, std::uint32_t delta)
+{
+    const std::uint32_t room = std::numeric_limits<std::uint32_t>::max() - value;
+    return delta > room ? std::numeric_limits<std::uint32_t>::max() : value + delta;
+}
+
+std::size_t mix_index(std::uint64_t key, std::size_t mask)
+{
+    // FNV output is well mixed in the high bits but less so in the low ones that a power-of-two mask keeps.
+    key ^= key >> 29;
+    key *= 0xBF58476D1CE4E5B9ULL;
+    key ^= key >> 32;
+    return static_cast<std::size_t>(key) & mask;
+}
+
+} // namespace
+
+std::uint32_t PersonalNgram::CountTable::get(std::uint64_t key) const
+{
+    if (keys_.empty())
+        return 0;
+    key = slot_key(key);
+    const std::size_t mask = keys_.size() - 1;
+    for (std::size_t index = mix_index(key, mask);; index = (index + 1) & mask)
+    {
+        if (keys_[index] == key)
+            return values_[index];
+        if (keys_[index] == 0)
+            return 0;
+    }
+}
+
+std::uint32_t PersonalNgram::CountTable::add(std::uint64_t key, std::uint32_t delta)
+{
+    // Load factor stays at or below one half, so probe runs stay short and a free slot always exists.
+    if ((size_ + 1) * 2 > keys_.size())
+        grow();
+    key = slot_key(key);
+    const std::size_t mask = keys_.size() - 1;
+    for (std::size_t index = mix_index(key, mask);; index = (index + 1) & mask)
+    {
+        if (keys_[index] == key)
+        {
+            const std::uint32_t before = values_[index];
+            values_[index] = saturating_add(before, delta);
+            return before;
+        }
+        if (keys_[index] == 0)
+        {
+            keys_[index] = key;
+            values_[index] = delta;
+            ++size_;
+            return 0;
+        }
+    }
+}
+
+void PersonalNgram::CountTable::grow()
+{
+    std::vector<std::uint64_t> keys(keys_.empty() ? 64 : keys_.size() * 2, 0);
+    std::vector<std::uint32_t> values(keys.size(), 0);
+    const std::size_t mask = keys.size() - 1;
+    for (std::size_t i = 0; i < keys_.size(); ++i)
+    {
+        if (keys_[i] == 0)
+            continue;
+        std::size_t index = mix_index(keys_[i], mask);
+        while (keys[index] != 0)
+            index = (index + 1) & mask;
+        keys[index] = keys_[i];
+        values[index] = values_[i];
+    }
+    keys_.swap(keys);
+    values_.swap(values);
+}
+
+void PersonalNgram::CountTable::clear()
+{
+    keys_.clear();
+    values_.clear();
+    size_ = 0;
+}
+
+void PersonalNgram::CountTable::swap(CountTable &other) noexcept
+{
+    keys_.swap(other.keys_);
+    values_.swap(other.values_);
+    std::swap(size_, other.size_);
+}
+
+PersonalNgram::PersonalNgram(PersonalNgramOptions options) : options_(options)
+{
+}
+
+void PersonalNgram::add(const PersonalTransition &transition)
+{
+    if (transition.word.empty() || transition.times == 0)
+        return;
+    const std::string &start = NgramTable::sentence_start();
+    const std::string &previous = transition.previous.empty() ? start : transition.previous;
+    add_pair(previous, transition.word, transition.times);
+    if (previous != start)
+        add_triple(transition.earlier.empty() ? start : transition.earlier, previous, transition.word,
+                   transition.times);
+}
+
+void PersonalNgram::add_pair(const std::string &previous, const std::string &word, std::uint32_t count)
+{
+    if (count == 0)
+        return;
+    pairs_.add(key_of(previous, word), count);
+    context_totals_.add(key_of(previous), count);
+    word_counts_.add(key_of(word), count);
+    total_ += count;
+}
+
+void PersonalNgram::add_triple(const std::string &earlier, const std::string &previous, const std::string &word,
+                               std::uint32_t count)
+{
+    if (count == 0)
+        return;
+    const std::uint64_t context = key_of(earlier, previous);
+    if (triples_.add(key_of(earlier, previous, word), count) == 0)
+        triple_followers_.add(context, 1);
+    triple_totals_.add(context, count);
+}
+
+void PersonalNgram::clear()
+{
+    pairs_.clear();
+    context_totals_.clear();
+    word_counts_.clear();
+    triples_.clear();
+    triple_totals_.clear();
+    triple_followers_.clear();
+    total_ = 0;
+}
+
+void PersonalNgram::swap(PersonalNgram &other) noexcept
+{
+    std::swap(options_, other.options_);
+    pairs_.swap(other.pairs_);
+    context_totals_.swap(other.context_totals_);
+    word_counts_.swap(other.word_counts_);
+    triples_.swap(other.triples_);
+    triple_totals_.swap(other.triple_totals_);
+    triple_followers_.swap(other.triple_followers_);
+    std::swap(total_, other.total_);
+}
+
+PersonalNgram::Context PersonalNgram::context(const std::string *earlier, const std::string &previous) const
+{
+    Context result;
+    if (total_ == 0)
+        return result;
+    const std::uint64_t previous_key = key_of(previous);
+    result.context_total = context_totals_.get(previous_key);
+    if (result.context_total == 0)
+        return result;
+    const double seen = static_cast<double>(result.context_total);
+    result.confidence = (std::min)(seen / (seen + options_.confidence_k), options_.max_confidence);
+    result.pair_state = separate(previous_key);
+    const std::string &start = NgramTable::sentence_start();
+    if (previous != start)
+    {
+        const std::uint64_t triple_context = key_of(earlier == nullptr ? start : *earlier, previous);
+        result.triple_total = triple_totals_.get(triple_context);
+        if (result.triple_total > 0)
+        {
+            result.triple_followers = triple_followers_.get(triple_context);
+            result.triple_state = separate(triple_context);
+        }
+    }
+    return result;
+}
+
+double PersonalNgram::bigram_probability(std::uint64_t pair_state, std::uint32_t context_total, const std::string &word,
+                                         std::uint64_t word_key) const
+{
+    double probability = 0.0;
+    if (context_total > 0)
+        probability += options_.lambda * static_cast<double>(pairs_.get(mix(pair_state, word))) /
+                       static_cast<double>(context_total);
+    if (total_ > 0)
+        probability +=
+            (1.0 - options_.lambda) * static_cast<double>(word_counts_.get(word_key)) / static_cast<double>(total_);
+    return probability;
+}
+
+double PersonalNgram::probability(const Context &context, const std::string &word) const
+{
+    if (context.context_total == 0 || word.empty())
+        return 0.0;
+    const double bigram = bigram_probability(context.pair_state, context.context_total, word, key_of(word));
+    if (context.triple_total == 0)
+        return bigram;
+    const double total = static_cast<double>(context.triple_total);
+    const double seen = static_cast<double>(triples_.get(mix(context.triple_state, word)));
+    const double discount = options_.trigram_discount;
+    return (std::max)(seen - discount, 0.0) / total +
+           discount * static_cast<double>(context.triple_followers) / total * bigram;
+}
+
+double PersonalNgram::confidence(const std::string &previous) const
+{
+    return context(nullptr, previous).confidence;
+}
+
+double PersonalNgram::bigram_probability(const std::string &previous, const std::string &word) const
+{
+    const std::uint64_t previous_key = key_of(previous);
+    return bigram_probability(separate(previous_key), context_totals_.get(previous_key), word, key_of(word));
+}
+
+double PersonalNgram::probability(const std::string &earlier, const std::string &previous,
+                                  const std::string &word) const
+{
+    return probability(context(&earlier, previous), word);
+}
+
