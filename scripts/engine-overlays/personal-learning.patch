+void test_replay_and_state(const std::filesystem::path &root)
+{
+    const auto directory = root / "replay";
+    prepare_dictionary(directory);
+    require(EnglishDictionary::ensure_schema(metasequoia::path_to_utf8(directory / "english.db")),
+            "The English fixture could not be created.");
+    {
+        auto owned = make_session(directory);
+        auto &session = *owned;
+        for (int i = 0; i < 3; ++i)
+        {
+            cycle(session);
+            session.reset_commit_context();
+        }
+        // Leave an uncompleted pair behind so the export has something to skip.
+        commit(session, "shui", "水");
+        commit(session, "shan", "山");
+    }
+    require(has_shanshui(directory) && transition_rows(directory) > 0, "The replay fixture was not learned.");
+
+    const auto fresh = root / "replay-fresh";
+    prepare_dictionary(fresh);
+    const auto result = user_dictionary::replay(metasequoia::path_to_utf8(journal_in(directory)),
+                                                metasequoia::path_to_utf8(fresh / "msime.db"),
+                                                metasequoia::path_to_utf8(directory / "english.db"));
+    require(result.failed == 0 && has_shanshui(fresh), "Replay did not restore the created word.");
+
+    std::vector<metasequoia::DictionaryStateRecord> records;
+    metasequoia::stream_dictionary_state(paths_in(directory), [&](const metasequoia::DictionaryStateRecord &record) {
+        records.push_back(record);
+        return true;
+    });
+    std::size_t next = 0;
+    const auto staged = metasequoia::stage_dictionary_state(directory, root / "replay-generation", "fixture",
+                                                            [&](metasequoia::DictionaryStateRecord &out) {
+                                                                if (next == records.size())
+                                                                    return false;
+                                                                out = records[next++];
+                                                                return true;
+                                                            });
+    const auto staged_journal = staged.user(metasequoia::assets::user_journal);
+    user_dictionary::close_default_user_database();
+    require(query_integer(staged_journal, "SELECT COUNT(*) FROM user_dictionary_operations WHERE value=?1", {"山水"}) ==
+                    1 &&
+                query_integer(staged_journal, "SELECT COUNT(*) FROM pick_transitions") == 0,
+            "A staged generation did not keep the word while dropping the pick counts.");
+}
+
+void test_public_session(const std::filesystem::path &root)
+{
+    const auto directory = root / "public";
+    prepare_dictionary(directory);
+    metasequoia::SessionOptions options;
+    options.paths = paths_in(directory);
+    metasequoia::Session session(options);
+    const auto commit_word = [&session](const std::string &pinyin, const std::string &word) {
+        for (const char character : pinyin)
+            require(session.character(character).handled, "A pinyin character was not handled.");
+        const auto view = session.snapshot();
+        const auto found = std::find_if(view.candidates.begin(), view.candidates.end(),
+                                        [&](const WordItem &item) { return item.word == word; });
+        require(found != view.candidates.end(), "A fixture candidate is missing.");
+        require(session.select(static_cast<std::size_t>(found - view.candidates.begin())).commit == word,
+                "A fixture candidate could not be committed.");
+    };
+
+    commit_word("shan", "山");
+    commit_word("shui", "水");
+    require(transition_count(directory, "山", "水") == 1, "The public session did not count a pair.");
+
+    commit_word("shan", "山");
+    session.reset_context();
+    commit_word("shui", "水");
+    require(transition_count(directory, "山", "水") == 1, "Session::reset_context did not end the pair.");
+
+    // A nine-key commit lands between the two picks without passing through the full-keyboard session.
+    commit_word("shan", "山");
+    session.set_nine_key_enabled(true);
+    require(session.character('6').handled && session.character('4').handled, "The grid did not take digits.");
+    require(session.select(0).commit.has_value(), "The grid did not commit.");
+    session.set_nine_key_enabled(false);
+    commit_word("shui", "水");
+    require(transition_count(directory, "山", "水") == 1, "A nine-key commit did not end the pair.");
+
+    for (const char character : std::string("shan"))
+        session.character(character);
+    session.finish();
+    commit_word("shui", "水");
+    require(transition_count(directory, "山", "水") == 1, "A flushed composition started a pair.");
+}
