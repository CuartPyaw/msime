+void add_variant(std::vector<SyllableTypo> &variants, const std::string &typed, const std::string &candidate,
+                 SyllableTypoKind kind)
+{
+    if (candidate.size() < 2 || intact_pinyin_set().count(candidate) == 0)
+        return;
+    const std::string intended = normalized(candidate);
+    if (intended == typed)
+        return;
+    for (auto &existing : variants)
+    {
+        if (existing.syllable != intended)
+            continue;
+        if (kind < existing.kind)
+            existing.kind = kind;
+        return;
+    }
+    variants.push_back({intended, kind});
+}
+
+std::vector<SyllableTypo> compute_typos(const std::string &syllable)
+{
+    std::vector<SyllableTypo> variants;
+    const std::string typed = normalized(syllable);
+    if (typed.size() < 2)
+        return variants;
+    for (std::size_t i = 0; i + 1 < syllable.size(); ++i)
+    {
+        if (syllable[i] == syllable[i + 1])
+            continue;
+        std::string swapped = syllable;
+        std::swap(swapped[i], swapped[i + 1]);
+        add_variant(variants, typed, swapped, SyllableTypoKind::Transposition);
+    }
+    for (std::size_t i = 0; i < syllable.size(); ++i)
+    {
+        for (char key = 'a'; key <= 'z'; ++key)
+        {
+            if (key == syllable[i] || !keys_adjacent(key, syllable[i]))
+                continue;
+            std::string substituted = syllable;
+            substituted[i] = key;
+            add_variant(variants, typed, substituted, SyllableTypoKind::Neighbor);
+        }
+    }
+    for (std::size_t i = 0; i < syllable.size(); ++i)
+    {
+        std::string shortened = syllable;
+        shortened.erase(i, 1);
+        add_variant(variants, typed, shortened, SyllableTypoKind::MissingOrExtra);
+    }
+    for (std::size_t i = 0; i <= syllable.size(); ++i)
+    {
+        for (char key = 'a'; key <= 'z'; ++key)
+        {
+            std::string lengthened = syllable;
+            lengthened.insert(lengthened.begin() + static_cast<std::ptrdiff_t>(i), key);
+            add_variant(variants, typed, lengthened, SyllableTypoKind::MissingOrExtra);
+        }
+    }
+    std::stable_sort(variants.begin(), variants.end(),
+                     [](const SyllableTypo &a, const SyllableTypo &b) { return a.kind < b.kind; });
