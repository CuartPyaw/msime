+bool is_storable_autocorrect_suppression(const std::string &folded_input)
+{
+    return is_lowercase_letters(folded_input, kMaxSuppressedInputLength);
+}
+
+bool record_autocorrect_suppression(const std::string &user_db_path, const std::string &folded_input)
+{
+    if (!is_storable_autocorrect_suppression(folded_input))
+        return false;
+    UserDatabase db(user_db_path);
+    if (!db || !execute_sql(db.get(), "BEGIN IMMEDIATE"))
+        return false;
+    auto upsert = prepare(db.get(), "INSERT INTO pinyin_autocorrect_suppressions(input,commits) VALUES(?1,1)"
+                                    " ON CONFLICT(input) DO UPDATE SET"
+                                    " commits=min(commits+1,?2),updated_at=unixepoch()");
+    const bool written = upsert && bind_text(upsert.get(), 1, folded_input) &&
+                         sqlite3_bind_int(upsert.get(), 2, kMaxTypoStateCount) == SQLITE_OK &&
+                         sqlite3_step(upsert.get()) == SQLITE_DONE;
+    upsert.reset();
+    if (written &&
+        trim_typo_table(db.get(), "pinyin_autocorrect_suppressions", "commits", "input=?2", {folded_input}) &&
+        execute_sql(db.get(), "COMMIT"))
+        return true;
+    (void)execute_sql(db.get(), "ROLLBACK");
+    return false;
+}
