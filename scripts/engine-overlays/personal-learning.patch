+void test_ledger()
+{
+    using metasequoia::RecentCommit;
+    using metasequoia::RecentCommits;
+    const auto commit = [](const std::string &text, std::size_t chars, const std::string &input) {
+        RecentCommit record;
+        record.text = text;
+        record.chars = chars;
+        record.input = input;
+        return record;
+    };
+    RecentCommits ledger;
+    for (int i = 0; i < 6; ++i)
+        ledger.remember(commit("w" + std::to_string(i), 1, "k" + std::to_string(i)));
+    require(ledger.records().size() == RecentCommits::kCapacity && ledger.records().front().text == "w2",
+            "The ledger did not keep only the newest records.");
+    ledger.remember(commit("", 0, "x"));
+    require(ledger.records().size() == RecentCommits::kCapacity, "Empty text was recorded.");
+
+    ledger.clear();
+    ledger.remember(commit("ab", 2, "ab"));
+    ledger.remember(commit("c", 1, "c"));
+    ledger.note_backspace();
+    require(ledger.records().back().is_erased() && !ledger.records().front().is_erased(),
+            "Backspace was not charged to the newest record first.");
+    ledger.note_backspace();
+    require(ledger.records().front().erased == 1 && !ledger.records().front().is_erased(),
+            "A partly deleted record counted as deleted.");
+    require(!ledger.take_retraction("ab", SchemeType::Quanpin) && ledger.records().size() == 1 &&
+                ledger.records().front().text == "ab",
+            "A partly deleted record was retracted, or a miss kept the deleted one.");
+    ledger.note_backspace();
+    require(!ledger.take_retraction("ab", SchemeType::Shuangpin) && ledger.records().empty(),
+            "A retype under another scheme matched.");
+
+    ledger.remember(commit("ab", 2, "ab"));
+    ledger.remember(commit("ab2", 1, "abc"));
+    for (int i = 0; i < 3; ++i)
+        ledger.note_backspace();
+    const auto newest = ledger.take_retraction("ab", SchemeType::Quanpin);
+    require(newest && newest->text == "ab2" && ledger.records().size() == 1,
+            "The newest matching deleted record was not the one retracted.");
+    require(ledger.take_retraction("ab", SchemeType::Quanpin)->text == "ab", "A prefix retype did not match.");
+    ledger.note_backspace();
+    require(ledger.records().empty(), "Deleting past every record kept the ledger.");
+
+    ledger.remember(commit("x", 1, "x"));
+    ledger.remember(commit("y", 1, "y"));
+    ledger.replace_last(commit("yz", 2, ""));
+    require(ledger.records().size() == 2 && ledger.records().back().text == "yz", "replace_last did not replace.");
+    RecentCommit with_receipt = commit("r", 1, "r");
+    with_receipt.receipt = user_dictionary::LearningReceipt{};
+    ledger.remember(std::move(with_receipt));
+    ledger.drop_receipts("r");
+    require(ledger.records().back().text == "r" && !ledger.records().back().receipt,
+            "drop_receipts removed the record or kept its receipt.");
+}
