+void test_learning(const std::filesystem::path &root)
+{
+    const auto fixture = make_fixture(root, "learning");
+    {
+        auto session = make_session(fixture, kAllTypes);
+        type(*session, "meiganxi");
+        const auto result = session->select_candidate("没关系");
+        require(result.handled && result.commit == "没关系" && !result.diagnostic,
+                "The typo sentence could not be committed.");
+        require(typo_count(fixture, "gan", "guan") == 1, "The accepted typo was not counted.");
+        require(query_integer(fixture.dictionary / "msime.db",
+                              "SELECT count(*) FROM tbl_3_m WHERE key='mei''guan''xi' AND value='没关系'") == 1,
+                "The typo sentence was not stored under its corrected reading.");
+    }
+    auto reopened = quanpin::PersonalTypoProfile::shared(fixture.journal());
+    require(reopened->accepted("gan", "guan") == 1, "A new profile did not see the stored count.");
+
+    const auto quiet = make_fixture(root, "learning-off");
+    {
+        auto session = make_session(quiet, kAllTypes, false);
+        type(*session, "meiganxi");
+        require(session->select_candidate("没关系").handled, "The typo sentence could not be committed.");
+        require(typo_count(quiet, "gan", "guan") == 0, "A typo was counted with learning off.");
+    }
+
+    double previous = quanpin::PersonalTypoProfile::discounted(20.0, 0);
+    require(previous == 20.0, "An unseen typo was discounted.");
+    for (int accepted = 1; accepted <= 2000; ++accepted)
+    {
+        const double current = quanpin::PersonalTypoProfile::discounted(20.0, accepted);
+        require(current <= previous && current >= 8.0 - 1e-9, "The discount is not monotonic or passed its floor.");
+        previous = current;
+    }
+    require(previous < 8.0 + 1e-9, "The discount never reached its floor.");
+}
