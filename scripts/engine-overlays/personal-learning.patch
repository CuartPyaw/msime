+void test_chain_breaks(const std::filesystem::path &root)
+{
+    const auto directory = root / "breaks";
+    prepare_dictionary(directory);
+    const auto journal = journal_in(directory);
+    struct Case
+    {
+        const char *name;
+
+        std::function<void(InputSession &)> action;
+
+        bool breaks;
+    };
+    const std::vector<Case> cases{
+        {"nothing", [](InputSession &) {}, false},
+        {"cancel",
+         [](InputSession &session) {
+             type(session, "hao");
+             session.handle_command(metasequoia::Command::Cancel);
+         },
+         false},
+        {"punctuation", [](InputSession &session) { session.handle_punctuation(','); }, true},
+        {"raw commit",
+         [](InputSession &session) {
+             type(session, "ni");
+             session.handle_command(metasequoia::Command::CommitRaw);
+         },
+         true},
+        {"edge selection",
+         [](InputSession &session) {
+             type(session, "nihao");
+             session.select_candidate_edge(0, metasequoia::CandidateEdge::FirstHan);
+         },
+         true},
+        {"scheme switch", [](InputSession &session) { session.switch_scheme(SchemeType::Quanpin); }, true},
+        {"state reset", [](InputSession &session) { session.reset_state(); }, true},
+        {"english mode",
+         [](InputSession &session) {
+             session.set_dedicated_english_mode(true);
+             session.set_dedicated_english_mode(false);
+         },
+         true},
+        {"idle backspace", [](InputSession &session) { session.handle_command(metasequoia::Command::Backspace); },
+         true},
+        {"idle caret move", [](InputSession &session) { session.handle_command(metasequoia::Command::MoveLeft); },
+         true},
+        {"idle enter", [](InputSession &session) { session.handle_command(metasequoia::Command::CommitCandidate); },
+         true},
+        {"idle digit", [](InputSession &session) { session.handle_character('3'); }, true},
+        {"english punctuation",
+         [](InputSession &session) {
+             session.set_chinese_punctuation_enabled(false);
+             session.handle_punctuation(',');
+         },
+         true},
+        {"punctuation lock",
+         [](InputSession &session) {
+             session.set_punctuation_lock(2);
+             session.handle_punctuation(',');
+         },
+         true},
+        {"short pause",
+         [](InputSession &session) {
+             const auto later = std::chrono::steady_clock::now() + std::chrono::seconds(3);
+             session.set_steady_clock_provider([later] { return later; });
+         },
+         false},
+        {"long pause",
+         [](InputSession &session) {
+             const auto later = std::chrono::steady_clock::now() + std::chrono::seconds(30);
+             session.set_steady_clock_provider([later] { return later; });
+         },
+         true},
+        {"reset context", [](InputSession &session) { session.reset_commit_context(); }, true},
+    };
+    for (const auto &entry : cases)
+    {
+        const auto chained = pair_count(journal, "甲", "丑");
+        const auto opened = pair_count(journal, start(), "丑");
+        auto owned = make_session(directory);
+        auto &session = *owned;
+        commit(session, "ni", "甲");
+        entry.action(session);
+        commit(session, "hao", "丑");
+        const bool broke =
+            pair_count(journal, start(), "丑") == opened + 2 && pair_count(journal, "甲", "丑") == chained;
+        const bool kept =
+            pair_count(journal, "甲", "丑") == chained + 2 && pair_count(journal, start(), "丑") == opened;
+        if (entry.breaks ? !broke : !kept)
+        {
+            std::fprintf(stderr, "chain case: %s\n", entry.name);
+            throw std::runtime_error("A chain break point did not behave as specified.");
+        }
+    }
+}
