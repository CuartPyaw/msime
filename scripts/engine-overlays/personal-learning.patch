+std::filesystem::path journal(const SessionOptions &options)
+{
+    return options.paths.user(metasequoia::assets::user_journal);
+}
+
+std::int64_t weight(const SessionOptions &options, const std::string &table, const std::string &word)
+{
+    return integer(dictionary(options), "SELECT weight FROM " + table + " WHERE value='" + word + "'");
+}
+
+// The working row, the journal row and the selection counters of one word: everything a pick of it can write.
+std::string learned_state(const SessionOptions &options, const std::string &table, const std::string &word)
+{
+    return rows(dictionary(options), "SELECT key,weight FROM " + table + " WHERE value='" + word + "'") + "/" +
+           rows(journal(options), "SELECT dictionary,key,operation,weight,display,user_inserted,updated_at FROM "
+                                  "user_dictionary_operations WHERE value='" +
+                                      word + "'") +
+           "/" +
+           rows(journal(options), "SELECT context_key,entry_key,selection_count FROM candidate_selection_state WHERE "
+                                  "value='" +
+                                      word + "'");
+}
+
+std::string personal_state(const SessionOptions &options)
+{
+    return rows(journal(options), "SELECT previous,word,count FROM personal_bigram ORDER BY previous,word") + "/" +
+           rows(journal(options), "SELECT earlier,previous,word,count FROM personal_trigram ORDER BY 1,2,3");
+}
+
+std::int64_t tombstones(const SessionOptions &options)
+{
+    return integer(journal(options), "SELECT COUNT(*) FROM user_dictionary_operations WHERE operation='delete'");
+}
+
+void type(Session &session, const std::string &text)
+{
+    for (const char character : text)
+        require(session.character(character).handled, "A pinyin key was not handled.");
+}
+
+std::size_t index_of(const Session &session, const std::string &word)
+{
+    const auto view = session.snapshot();
+    for (std::size_t i = 0; i < view.candidates.size(); ++i)
+        if (view.candidates[i].word == word)
+            return i;
+    throw std::runtime_error("Missing fixture candidate " + word);
+}
+
+KeyResult pick(Session &session, const std::string &input, const std::string &word)
+{
+    type(session, input);
+    const auto result = session.select(index_of(session, word));
+    require(result.handled && result.commit == word, "Could not commit " + word);
+    return result;
+}
+
+void backspace(Session &session, int times)
+{
+    for (int i = 0; i < times; ++i)
+        require(!session.command(Command::Backspace).handled, "An idle Backspace was consumed.");
+}
