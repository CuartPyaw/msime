+void test_gating(const std::filesystem::path &root)
+{
+    const auto fixture = make_fixture(root, "gating");
+    {
+        // Either legacy switch also carries the deletion and insertion bits (see autocorrect_types_from_request), so
+        // the missing-letter edges can only be observed off with correction off altogether.
+        auto off = make_session(fixture, 0);
+        type(*off, "meiganxi");
+        require(typo_row(*off) < 0, "A typo sentence appeared with correction off.");
+        cancel(*off);
+
+        auto table_only = make_session(fixture, kTableTypes);
+        type(*table_only, "meiganxi");
+        require(typo_row(*table_only) >= 0, "The legacy switches did not carry the missing-letter edges.");
+        cancel(*table_only);
+
+        auto session = make_session(fixture, kAllTypes);
+        type(*session, "meiganxi");
+        const int row = typo_row(*session);
+        require(row >= 0, "The typo sentence did not appear.");
+        const auto &item = session->candidates()[static_cast<std::size_t>(row)];
+        require(item.word == "没关系" && item.corrected_from == "meiganxi" && item.canonical_pinyin == "mei'guan'xi",
+                "The typo sentence carries the wrong reading or label.");
+        const int literal = index_of(*session, "没干系");
+        require(literal >= 0 && literal < row, "The typo sentence did not follow the literal sentence.");
+        require(session->candidate_annotations()[static_cast<std::size_t>(row)] == "meiganxi",
+                "The typo sentence is not annotated as corrected.");
+        cancel(*session);
+
+        type(*session, "meiguanxi");
+        require(typo_row(*session) < 0 && !any_corrected(*session), "A correctly typed input was corrected.");
+        require(session->candidates().front().word == "没关系", "The literal sentence is not first.");
+        cancel(*session);
+    }
+
+    InputSession shuangpin(SchemeType::Shuangpin, GetXiaoheShuangpinProfile(), fixture.paths());
+    shuangpin.set_quanpin_autocorrect_types(kAllTypes);
+    type(shuangpin, "mwgjxi");
+    require(!shuangpin.candidates().empty(), "The shuangpin fixture produced no candidates.");
+    require(typo_row(shuangpin) < 0, "Shuangpin produced a typo sentence.");
+    cancel(shuangpin);
+}
