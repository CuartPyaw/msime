+    #[test]
+    fn rerank_declines_before_building_single_path_state() {
+        let Ok(path) = crate::lattice::neural::test_model_path(assets::NEURAL_MODEL_KEYBOARD)
+        else {
+            eprintln!("skipped: 需要固定键盘模型资源");
+            return;
+        };
+        let model = std::sync::Arc::new(
+            chinese_ime_lm::SentenceModel::load(&std::fs::read(path).unwrap()).unwrap(),
+        );
+        for word_lattice in [true, false] {
+            for count in [0, 1] {
+                let mut session = detached();
+                session.sentence_association = SentenceAssociationOptions {
+                    neural_keyboard: true,
+                    word_lattice,
+                    ..SentenceAssociationOptions::default()
+                };
+                session.keyboard = Some(Some(NeuralReranker::new(
+                    CandidateSource::NeuralKeyboard,
+                    std::sync::Arc::clone(&model),
+                )));
+                let mut candidates: Vec<_> = (0..count).map(|_| sentence("唯一整句", 0)).collect();
+                let ((), allocations) = crate::ime::personal_rerank::allocations::count(|| {
+                    session.rerank_sentences(&mut candidates)
+                });
+                assert_eq!(allocations, 0);
+                if word_lattice && count == 1 {
+                    assert_eq!(
+                        row_sources(&candidates),
+                        [("唯一整句", CandidateSource::Generated)]
+                    );
+                } else {
+                    assert!(candidates.is_empty());
+                }
+                assert!(session.rerank_cache.is_empty());
+            }
+        }
+    }
