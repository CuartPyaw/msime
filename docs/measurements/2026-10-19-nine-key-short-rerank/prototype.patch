+    fn short_rerank_model() -> Option<std::sync::Arc<chinese_ime_lm::SentenceModel>> {
+        let path = match crate::lattice::neural::test_model_path(assets::NEURAL_MODEL_KEYBOARD) {
+            Ok(path) => path,
+            Err(reason) => {
+                eprintln!("skipped: {reason}");
+                return None;
+            }
+        };
+        Some(std::sync::Arc::new(
+            chinese_ime_lm::SentenceModel::load(&std::fs::read(path).unwrap()).unwrap(),
+        ))
+    }
+
+    fn short_rerank_session(
+        model: Option<&std::sync::Arc<chinese_ime_lm::SentenceModel>>,
+    ) -> NineKeySession {
+        let mut session = detached();
+        session.sentence_association.neural_keyboard = true;
+        session.keyboard = Some(model.map(|model| {
+            NeuralReranker::new(
+                CandidateSource::NeuralKeyboard,
+                std::sync::Arc::clone(model),
+            )
+        }));
+        session
+    }
+
+    fn short_rerank_rows(count: usize) -> Vec<WordItem> {
+        [
+            "你好",
+            "你们",
+            "您好",
+            "今天",
+            "明天",
+            "天气",
+            "你好啊",
+            "你好呀",
+            "大家好",
+            "天好",
+            "朋友",
+            "您好呀",
+        ]
+        .into_iter()
+        .take(count)
+        .enumerate()
+        .map(|(index, text)| sentence(text, -(index as i64) * 100))
+        .collect()
+    }
+
+    #[test]
+    fn short_rerank_preserves_model_load_and_sequence_outputs() {
+        // 缺失模型也沿用原来的首次加载与失败缓存时机。
+        for count in [0, 1, 2] {
+            let mut old = detached();
+            let mut new = detached();
+            old.sentence_association.neural_keyboard = true;
+            new.sentence_association.neural_keyboard = true;
+            old.frozen_rerank_sentences(&mut short_rerank_rows(count));
+            new.rerank_sentences(&mut short_rerank_rows(count));
+            assert!(matches!(old.keyboard, Some(None)));
+            assert!(matches!(new.keyboard, Some(None)));
+        }
+        let Some(model) = short_rerank_model() else {
+            return;
+        };
+        for available in [false, true] {
+            for word_lattice in [false, true] {
+                for duplicate in [false, true] {
+                    let mut old = short_rerank_session(available.then_some(&model));
+                    let mut new = short_rerank_session(available.then_some(&model));
+                    for session in [&mut old, &mut new] {
+                        session.sentence_association.word_lattice = word_lattice;
+                        session.sentence_association.show_next_on_duplicate = duplicate;
+                    }
+                    for context in ["", "合成上文", "另一段上文"] {
+                        old.rescoring_context = context.into();
+                        new.rescoring_context = context.into();
+                        for count in [2, 1, 0, 2, 12, 1, 12, 2, 0] {
+                            let mut a = short_rerank_rows(count);
+                            let mut b = a.clone();
+                            old.frozen_rerank_sentences(&mut a);
+                            new.rerank_sentences(&mut b);
+                            assert_eq!(a, b);
+                            assert_eq!(a.capacity(), b.capacity());
+                            if available && count >= 2 {
+                                let input = short_rerank_rows(count);
+                                let (scored, len) = collect_lattice_sentences(&input);
+                                let matching = |entry: &&RerankEntry| {
+                                    rerank_cache_matches(entry, context, &scored[..len])
+                                };
+                                let left = old.rerank_cache.iter().find(matching).unwrap();
+                                let right = new.rerank_cache.iter().find(matching).unwrap();
+                                assert_eq!(left.context, right.context);
+                                assert_eq!(left.sentences, right.sentences);
+                                assert_eq!(left.ranked, right.ranked);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
