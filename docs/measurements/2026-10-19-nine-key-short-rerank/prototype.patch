+    #[test]
+    fn short_rerank_preserves_mixed_rows_after_cache_eviction() {
+        let Some(model) = short_rerank_model() else {
+            return;
+        };
+        for word_lattice in [false, true] {
+            for duplicate in [false, true] {
+                let mut old = short_rerank_session(Some(&model));
+                let mut new = short_rerank_session(Some(&model));
+                for session in [&mut old, &mut new] {
+                    session.sentence_association.word_lattice = word_lattice;
+                    session.sentence_association.show_next_on_duplicate = duplicate;
+                    session.rescoring_context = "合成上文".into();
+                }
+                let compare =
+                    |old: &mut NineKeySession, new: &mut NineKeySession, mut a: Vec<WordItem>| {
+                        let mut b = Vec::with_capacity(a.capacity());
+                        b.extend(a.iter().cloned());
+                        old.frozen_rerank_sentences(&mut a);
+                        new.rerank_sentences(&mut b);
+                        assert_eq!(a, b);
+                        assert_eq!(a.capacity(), b.capacity());
+                    };
+                compare(&mut old, &mut new, short_rerank_rows(2));
+                for index in 0..=RERANK_CACHE_ENTRIES {
+                    for count in [0, 1] {
+                        let mut rows = vec![item("你好", "64426", 1000, CandidateSource::Database)];
+                        rows.extend(short_rerank_rows(count).into_iter().map(|mut row| {
+                            row.weight = -(index as i64);
+                            row
+                        }));
+                        rows.push(item("你们", "64636", 0, CandidateSource::Generated));
+                        compare(&mut old, &mut new, rows);
+                    }
+                }
+                // 旧实现被短列表挤出有效排名；新实现保留它，两者后续输出仍须一致。
+                assert_eq!(old.rerank_cache.len(), RERANK_CACHE_ENTRIES);
+                assert_eq!(new.rerank_cache.len(), 1);
+                compare(&mut old, &mut new, short_rerank_rows(2));
+                compare(&mut old, &mut new, short_rerank_rows(12));
+            }
+        }
+    }
