+    #[test]
+    #[ignore = "手动普通System分配器完整重排入口配对，不能与构建同时运行"]
+    fn short_rerank_complete_paired_budget() {
+        use std::hint::black_box;
+        use std::time::{Duration, Instant};
+        let model = short_rerank_model().expect("计时必须提供固定键盘模型");
+        let run = |session: &mut NineKeySession,
+                   rows: &[WordItem],
+                   cold: bool,
+                   old: bool,
+                   iterations: usize| {
+            let start = Instant::now();
+            for _ in 0..iterations {
+                if cold {
+                    session.rerank_cache.clear();
+                }
+                let mut candidates = black_box(rows).to_vec();
+                if old {
+                    session.frozen_rerank_sentences(black_box(&mut candidates));
+                } else {
+                    session.rerank_sentences(black_box(&mut candidates));
+                }
+                black_box(&candidates);
+                drop(candidates);
+            }
+            start.elapsed()
+        };
+        let mut failures = Vec::new();
+        for count in [0, 1, 2] {
+            for available in [false, true] {
+                for cold in [false, true] {
+                    let rows = short_rerank_rows(count);
+                    let mut old = short_rerank_session(available.then_some(&model));
+                    let mut new = short_rerank_session(available.then_some(&model));
+                    run(&mut old, &rows, cold, true, 2);
+                    run(&mut new, &rows, cold, false, 2);
+                    let mut iterations = 128;
+                    while run(&mut old, &rows, cold, true, iterations) < Duration::from_millis(5) {
+                        iterations *= 2;
+                    }
+                    let mut ratios = Vec::new();
+                    for pair in 0..21 {
+                        let (a, b) = if pair % 2 == 0 {
+                            (
+                                run(&mut old, &rows, cold, true, iterations),
+                                run(&mut new, &rows, cold, false, iterations),
+                            )
+                        } else {
+                            let b = run(&mut new, &rows, cold, false, iterations);
+                            (run(&mut old, &rows, cold, true, iterations), b)
+                        };
+                        println!("short-rerank-pair,{count},{available},{cold},{pair},{iterations},{},{}", a.as_nanos(), b.as_nanos());
+                        ratios.push(b.as_secs_f64() / a.as_secs_f64());
+                    }
+                    ratios.sort_by(f64::total_cmp);
+                    let limit = if count < 2 && available && cold {
+                        0.98
+                    } else {
+                        1.05
+                    };
+                    println!(
+                        "short-rerank-summary,{count},{available},{cold},{},{limit}",
+                        ratios[10]
+                    );
+                    if ratios[10] >= limit {
+                        failures.push((count, available, cold, ratios[10], limit));
+                    }
+                }
+            }
+        }
+        assert!(failures.is_empty(), "预算失败：{failures:?}");
+    }
